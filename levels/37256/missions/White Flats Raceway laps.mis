{
	friction = 5;
	restitution = 1;
	force = 0;
};
new MaterialProperty(MBFMaterialSnow)
{
	friction = 15;
	restitution = 0;
	force = 0;
};
new MaterialProperty(MBFMaterialGrass)
{
	friction = 1.5;
	restitution = 0.5;
};
new MaterialProperty(MBFMaterialGranite)
{
	friction = 0.2;
	restitution = 1;
};
new MaterialProperty(MBFMaterialHockey)
{
	friction = 0.01;
	restitution = 1;
	force = 2;
};
new MaterialProperty(HighFrictionMaterial)
{
	friction = 1.5;
	restitution = 0.5;
};
