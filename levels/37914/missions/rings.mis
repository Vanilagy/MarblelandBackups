$ringBoostPower     = 30;
$ringNearRadius     = 0.8;
$ringPowerupRadius  = 1.75;
$ringGemRadius      = 2.2;
$ringDebug          = true;
$ringSkipPQ         = false;
$ringForceActiveSfx = false;  // no blurps
$ringAngleSign      = -1;
$ringVoiceDelay     = 0;     // no hiccups

function MRPlayOnce(%name)
{
   if (!isObject(nameToID(%name)))
   {
      return;
   }
   %now = getRealTime();
   if (%now - $MRLastPlay[%name] < 400)
      return;
   $MRLastPlay[%name] = %now;
   %h = alxPlay(%name);
}

function MRPlayProfile(%id, %pos)
{
   if (%pos $= "")
      alxPlay(%id);
   else
      alxPlay(%id, getWord(%pos, 0), getWord(%pos, 1), getWord(%pos, 2));
}

function clientCmdMRRingSound(%names, %pos)
{
   %n = getWordCount(%names);
   for (%i = 0; %i < %n; %i++)
   {
      %name = getWord(%names, %i);
      %id = nameToID(%name);
      if (isObject(%id))
      {
         if ($ringDebug)
         if (getSubStr(%name, 0, 3) $= "RV_")
         {
            if ($ringVoiceDelay > 0)
               schedule($ringVoiceDelay, 0, MRPlayOnce, %name);
            else
               MRPlayOnce(%name);
         }
         else
            MRPlayProfile(%id, %pos);
         return;
      }
   }
}

function MRScanSounds(%group)
{
   for (%i = 0; %i < %group.getCount(); %i++)
   {
      %o = %group.getObject(%i);
      if (%o.getClassName() $= "SimGroup" || %o.getClassName() $= "SimSet")
         MRScanSounds(%o);
      else if (%o.getClassName() $= "AudioProfile")
      {
         %n = strlwr(%o.getName());
         if (strstr(%n, "voice") >= 0 || strstr(%n, "super") >= 0 || strstr(%n, "heli") >= 0 || strstr(%n, "gyro") >= 0 || strstr(%n, "bounce") >= 0 || strstr(%n, "shock") >= 0 || strstr(%n, "speed") >= 0)
            echo("MR sound profile:" SPC %o.getName() SPC "file=" @ %o.filename);
      }
   }
}

function MRListSounds()
{
   if (isObject(ClientAudioGroup))
      MRScanSounds(ClientAudioGroup);
   if (isObject(DataBlockGroup))
      MRScanSounds(DataBlockGroup);
   if (isObject(RootGroup))
      MRScanSounds(RootGroup);
}

// HELPERS

function ringPos(%t)
{
   return getWords(%t, 0, 2);
}

function ringUp(%t)
{
   %k = VectorNormalize(getWords(%t, 3, 5));
   %a = getWord(%t, 6) * $ringAngleSign;
   %kx = getWord(%k, 0);
   %ky = getWord(%k, 1);
   %kz = getWord(%k, 2);
   %s = mSin(%a);
   %c = mCos(%a);
   %q = 1 - %c;
   return (%ky * %s + %kx * %kz * %q) SPC (-%kx * %s + %ky * %kz * %q) SPC (%c + %kz * %kz * %q);
}

function ringCollect(%group)
{
   for (%i = 0; %i < %group.getCount(); %i++)
   {
      %o = %group.getObject(%i);
      if (%o.getClassName() $= "SimGroup")
         ringCollect(%o);
      else if (%o.getClassName() $= "StaticShape")
      {
         %cls = %o.getDataBlock().classname;
         if (%cls $= "Ring" || %cls $= "RingGem")
         {
            $ringList[$ringCount] = %o;
            $ringCount++;
         }
      }
   }
}

function ringCrossed(%ring, %pos1, %pos2, %radius)
{
   if (%pos1 $= "")
      return false;

   %orig = ringPos(%ring.getTransform());
   %nor  = ringUp(%ring.getTransform());

   %d1 = VectorDot(%pos1, %nor) - VectorDot(%orig, %nor);
   %d2 = VectorDot(%pos2, %nor) - VectorDot(%orig, %nor);
   %den = %d1 - %d2;
   if (%den == 0)
      return false;

   %k = %d1 / %den;
   if (%k < 0 || %k > 1)
      return false;

   %pos3 = VectorAdd(%pos1, VectorScale(VectorSub(%pos2, %pos1), %k));
   return VectorDist(%pos3, %orig) < %radius * getWord(%ring.getScale(), 0);
}

function ringNear(%ring, %pos, %radius)
{
   %orig = ringPos(%ring.getTransform());
   return VectorDist(%pos, %orig) < %radius * getWord(%ring.getScale(), 0);
}

function ringPlaySound(%client, %snd, %pos)
{
   if (%snd $= "")
      return;
   if (getSubStr(%snd, 0, 3) $= "RV_")
   {
      if ($ringDebug)
      if ($ringVoiceDelay > 0)
         schedule($ringVoiceDelay, 0, MRPlayOnce, %snd);
      else
         MRPlayOnce(%snd);
   }
   if (isObject(%client))
      commandToClient(%client, 'MRRingSound', %snd, %pos);
}

function ringPass(%ring, %player)
{
   %db = %ring.getDataBlock();
   %client = %player.client;
   %pos = ringPos(%player.getTransform());

   if ($ringDebug)

   if (%db.ringBoost)
   {
      ringPlaySound(%client, %db.ringActiveSound, %pos);
      ringPlaySound(%client, %db.ringSound, %pos);
      %vel = VectorAdd(%player.getVelocity(), VectorScale(ringUp(%ring.getTransform()), $ringBoostPower));
      %player.setVelocity(%vel);
      return;
   }

   %item = %db.ringItem;
   if (!isObject(%item))
   {
      ringPlaySound(%client, %db.ringSound, %pos);
      return;
   }

   ringPlaySound(%client, %db.ringSound, %pos);

   if ($ringSkipPQ)
   {
      ringPlaySound(%client, %db.ringActiveSound, %pos);
      return;
   }

   commandToClient(%client, 'doPowerUp', %item.powerUpId);
   %item.onUse(%ring, %player);

   if ($ringForceActiveSfx)
      ringPlaySound(%client, %db.ringActiveSound, %pos);
}

function ringResetPlayer(%player)
{
   for (%i = 0; %i < $ringCount; %i++)
   {
      %player.ringPrev[%i] = "";
      %player.ringTimer[%i] = 200;
   }
}

function ringFrame(%delta)
{
   for (%c = 0; %c < ClientGroup.getCount(); %c++)
   {
      %player = ClientGroup.getObject(%c).player;
      if (!isObject(%player))
         continue;

      %pos2 = ringPos(%player.getTransform());

      for (%i = 0; %i < $ringCount; %i++)
      {
         %ring = $ringList[%i];
         if (!isObject(%ring))
            continue;

         %player.ringTimer[%i] -= %delta;
         %cls = %ring.getDataBlock().classname;

         if (%cls $= "Ring")
         {
            if (%player.ringTimer[%i] <= 0 && (ringCrossed(%ring, %player.ringPrev[%i], %pos2, $ringPowerupRadius) || ringNear(%ring, %pos2, $ringNearRadius)))
            {
               ringPass(%ring, %player);
               %player.ringTimer[%i] = 200;
            }
         }
         else
         {
            %gem = %ring.myGem;
            if (isObject(%gem))
            {
               if (!%ring.collected && %gem.isHidden())
                  %ring.collected = true;

               if (!%ring.collected)
               {
                  if (%player.ringTimer[%i] <= 0 && ringCrossed(%ring, %player.ringPrev[%i], %pos2, $ringGemRadius))
                  {
                     %ring.collected = true;
                     %player.ringTimer[%i] = 200;

                     %gem.getDataBlock().onPickup(%gem, %player, 1);

                     if (!%gem.isHidden())
                        %gem.hide(true);
                  }
               }
               else if (%c == 0)
               {
                  %scl = getWord(%ring.getScale(), 0) - %delta / 500;
                  if (%scl < 0)
                     %scl = 0;
                  %ring.setScale(%scl SPC %scl SPC %scl);
               }
            }
         }
         %player.ringPrev[%i] = %pos2;
      }
   }
}

function serverCbOnMissionLoaded()
{
   $ringCount = 0;
   ringCollect(MissionGroup);
   if ($ringDebug)
   {
      MRListSounds();
   }

   for (%i = 0; %i < $ringCount; %i++)
   {
      %ring = $ringList[%i];
      %db = %ring.getDataBlock();
      %ring.setScale("2 2 2");
      %ring.playThread(0, "spin");

      if (%db.classname $= "Ring")
      {
         %ring.setSkinName(%db.color);
         %ring.powerUpSound = getWord(%db.ringSound, 0);
      }
      else
      {
         %ring.collected = "";

         %old = %ring.myGem;
         if (isObject(%old) && %old.getClassName() $= "Item" && %old._ringGem)
         {
            %old.hide(false);
            continue;
         }

         %gem = new Item()
         {
            position = ringPos(%ring.getTransform());
            rotation = "1 0 0 0";
            scale = "2 2 2";
            dataBlock = "GemItemYellow";
            collideable = "0";
            static = "1";
            rotate = "1";
         };
         MissionGroup.add(%gem);
         %gem._ringGem = true;
         %ring.myGem = %gem;
      }
   }
}

function serverCbOnMissionReset()
{
   for (%i = 0; %i < $ringCount; %i++)
   {
      %r = $ringList[%i];
      if (isObject(%r))
      {
         %r.setScale("2 2 2");
         %r.collected = "";
         if (isObject(%r.myGem))
            %r.myGem.hide(false);
      }
   }
   for (%c = 0; %c < ClientGroup.getCount(); %c++)
   {
      %p = ClientGroup.getObject(%c).player;
      if (isObject(%p))
         ringResetPlayer(%p);
   }
}

function serverCbOnRespawn()
{
   for (%c = 0; %c < ClientGroup.getCount(); %c++)
   {
      %p = ClientGroup.getObject(%c).player;
      if (isObject(%p))
         ringResetPlayer(%p);
   }
}

function serverCbOnFrameAdvance(%delta)
{
   ringFrame(%delta);
}
