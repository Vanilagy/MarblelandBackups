datablock StaticShapeData(PowerUpRing)
{
   category = "Rings";
   classname = "Ring";
   shapeFile = "~/data/shapes/rings/pupring.dts";
   scopeAlways = true;
   color = "base";
   ringItem = "SuperJumpItem_PQ";
   ringSound = "";
   ringPickupSound = "";
   ringActiveSound = "";
};

datablock StaticShapeData(SuperJumpRing : PowerUpRing)
{
   ringItem = "SuperJumpItem_PQ";
   ringSound = "RV_SuperJump";
   ringPickupSound = "RV_SuperJump";
   ringActiveSound = "DoSuperJumpSfx";
};

datablock StaticShapeData(SuperSpeedRing : PowerUpRing)
{
   color = "orange";
   ringItem = "";
   ringBoost = true;
