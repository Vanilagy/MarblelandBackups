new SimGroup(MissionGroup) {

   new ScriptObject(MissionInfo) {
         artist = "Rasterwerks; rep. by ejr";
         awesomeHint = "Get used to each zone\'s layout, and try not to get stuck, especially in cramped areas, or places you can\'t reach without a power-up. Try not to get bounced back when climbing stairs, either. Practice makes perfect!";
         awesomeTime = "540000";
         customRadarRule = "0";
         desc = "Explore four cool locations as you find all 200 gems in this MB rendition of a 3D Shockwave webgame. Can you find all four easter eggs and the secret area?\n\nLevel maps converted from Alien Space Bugs Attack, (c) Warner Media";
         easterEggHint = "There\'s a different type of easter egg at the highest, reachable point (or near highest point) in each zone. Find all four!";
         eggHint = "See the Easter Egg Hint. And yes, one of them is a nest egg.";
         game = "Platinum";
         gameMode = "null";
         generalHint = "You need a total of 21 gems before teleporting from the warehouse to the outdoor area, 118 gems before going to the stage, and 154 gems before going to the tower. Once you enter a new area there\'s no going back!\n\nReuse power-ups wherever you find them; there aren\'t very many scattered around. Wall-hits are your friend, and remember to combine a jump with a super-jump if necessary!";
         level = "1000";
         name = "WB Kidsville";
         noBlast = "1";
         platinumTime = "660000";
         radar = "1";
         startHelpText = "Please pardon the interior glitches; that\'s how they came out converting :/";
         type = "Custom";
         ultimateHint = "Use the radar! Also, in the tower zone, if you miss any gems, drop down to them and use a Super Jump that\'s in front of a ladder.";
         ultimateTime = "600000";
   };
