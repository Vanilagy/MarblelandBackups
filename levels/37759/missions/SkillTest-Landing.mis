         name = "Landing Control";
         noBlast = "1";
         partial = "0";
         platinumTime = "600000";
         startHelpText = "Can you control your landing after this launch?";
         trivia = "Level created on March 28, 2026\nUpdates:\nSeptember 23, 2026 - Added camera path, icon picture, challenge times, hints, and trivia.\nTrivia:\nA sequel to Marginally, this time focusing around landing control-oriented obstacles (none of which were inspired from Marbleland iirc), this level is a lot more developed. By this time I not only had learned how to round things to the grid (finally!) and use help triggers, I had also figured out moving platforms, more interiors, and gained a better understanding of level design and what the marble can do. This is thus a pretty pristine level.";
         type = "Custom";
         ultimateHint = "The tornado section also involves tornado mastery; you must know how to control a tornado\'s grasp on you to get past that. And the absolute hardest part is the gravity part, so be ready.";
         ultimateTime = "300000";
