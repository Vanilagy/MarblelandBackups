new SimGroup(MissionGroup) {

   new ScriptObject(MissionInfo) {
         artist = "charlemaniac";
         awesomeHint = "My goodness is this one tough! If you put up with stuff like this... hold on I did just that... anyway you can skip the second checkpoint area with a precise jump on the fan.";
         awesomeTime = "180000";
         customRadarRule = "47";
         desc = "Upward past all the challenges!";
         game = "PlatinumQuest";
         gameMode = "null";
         generalHint = "This is a puzzle level, so be ready to think on your own and without guidance from help triggers. Some of the puzzles are harder than others! But beware; overall the gameplay itself is also pretty difficult, so don\'t be alarmed if it takes you an hour or so to complete this level.";
         level = "1000";
         music = "Seaside Revisited.ogg";
         name = "Upward to Oblivion";
         platinumTime = "585000";
         radar = "1";
         startHelpText = "This level is an upward journey, and you must puzzle your way through the interiors.";
         trivia = "Level created on June 28, 2025
Updates:
March 8, 2026 - Raised ending platform quite a lot and added bounds.
September 17, 2026 - Added camera path, icon picture, challenge times, hints, and changed trivia.
Trivia:
For this level, I took inspiration from a couple notable levels from the recent list in marbleland: "think" by jpalman and a kodas level called something like "who can finish this level" (the ending of this level is primarily inspired from that). This level overall is a very difficult puzzle level built in the PQ level editor. It's pretty high effort for not having figured many things out yet, and the puzzles still hold up to standards more than a year later.";
         type = "Custom";
         ultimateHint = "There are many ways to optimize this level. Think about the possible orders to get the gems in each puzzle, like for example the first checkpoint area. Which gem would be better to get first? How could you use the objects provided for an optimal route? Optimizational thinking can really get you through this.";
         ultimateTime = "330000";
   };
