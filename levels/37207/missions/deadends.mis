if (!isObject(SpotLight)) {
   datablock fxLightData(SpotLight)
   {
      LightOn    = true;
      Radius     = 2;
      Brightness = 6;
      Colour     = "0.7 0.7 0.6 0.7";
   };
} else {
   SpotLight.Radius = 2;
   SpotLight.Brightness = 6;
   SpotLight.Colour = "0.7 0.7 0.6 0.7";
}

function attachMarbleLight() {
   if (!isObject(MarbleSpotLight)) {
      new fxLight(MarbleSpotLight) { dataBlock = "SpotLight"; };
      MissionCleanup.add(MarbleSpotLight);
   }
   for (%i = 0; %i < ClientGroup.getCount(); %i++) {
      %client = ClientGroup.getObject(%i);
      if (isObject(%client.player)) {
         MarbleSpotLight.setParent(%client.player, "", 1, "0 0 2", 1);
         return;
      }
   }
}

function serverCbOnRespawn(%client) {
   attachMarbleLight();
}

