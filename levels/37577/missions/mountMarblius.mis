	skin[5] = "pink";
	skin[6] = "green";
	skin[7] = "platinum";
	skin[8] = "blue";
   skin[9] = "yellow";
	
	pickupName = "a gem!";

	fxEmitter[0] = "GemEmitter";

	customField[0, "field"  ] = "skin";
