new MaterialProperty(PQUPBouncyMaterial) {
	friction = 1;
	restitution = 2;
	force = 15;
};

addMaterialMapping("bouncy" , PQUPBouncyMaterial);

// thanks claude

datablock StaticShapeData(Cloud24PQUP : Cloud24) {
	className = "Scenery";
	superCategory = "Scenery";
	category = "Clouds";
	shapeFile = "~/data/shapes_pqup/clouds/Cloud24.dts";
	skin[0] = "base";
	skin[1] = "b03";
	skin[2] = "b04";
	skin[3] = "b05";
	skin[4] = "b06";
	skin[5] = "b07";
	skin[6] = "b08";
	skin[7] = "b09";
	skin[8] = "b10";
	skin[9] = "b11";

	customField[0, "field"  ] = "skin";
	customField[0, "type"   ] = "string";
	customField[0, "name"   ] = "Skin Name";
	customField[0, "desc"   ] = "Which skin to use (see skin selector).";
	customField[0, "default"] = "";
};
function syncObjectRotationWithCamera(%shapeId)
{
    if (!isObject(%shapeId))
        return;

    %client = LocalClientConnection;
    if (isObject(%client))
    {
        %controlObj = %client.getControlObject();
        
        if (isObject(%controlObj))
        {
            %shapePos = %shapeId.getPosition();
            %targetPos = "";

            if (%controlObj.getClassName() $= "Marble")
            {
                %targetPos = %controlObj.getPosition();
            }
            else
            {
                %targetPos = getWords(%controlObj.getTransform(), 0, 2);
            }

            if (%targetPos !$= "")
            {
                %dirX = getWord(%targetPos, 0) - getWord(%shapePos, 0);
                %dirY = getWord(%targetPos, 1) - getWord(%shapePos, 1);
                %dirZ = getWord(%targetPos, 2) - getWord(%shapePos, 2);

                if (%dirX == 0 && %dirY == 0)
                    %dirY = 0.1;

                %yaw = mAtan(%dirX, %dirY);

                %dist2D = mSqrt((%dirX * %dirX) + (%dirY * %dirY));
                %pitch = mAtan(%dirZ, %dist2D);

                if (%controlObj.getClassName() $= "Marble")
                {
                    %yaw = (-%yaw) + 3.14159265; 
                    
                    %pitch = -%pitch; 
                }
                else
                {
                    %yaw = -%yaw;
                    %pitch = %pitch;
                }

                %eulerRot = %pitch SPC "0" SPC %yaw;
                %matrix = MatrixCreateFromEuler(%eulerRot);
                %finalRot = getWords(%matrix, 3, 6);

                %shapeId.setTransform(%shapePos SPC %finalRot);
            }
        }
    }

    %shapeId.cameraSyncSchedule = schedule(32, %shapeId, "syncObjectRotationWithCamera", %shapeId);
}

function Cloud24PQUP::onAdd(%this, %obj)
{
    syncObjectRotationWithCamera(%obj);
	%obj.playThread(0, "M");
}

function Cloud24PQUP::onRemove(%this, %obj)
{
    cancel(%obj.cameraSyncSchedule);
}

datablock ItemData(GemItemPQUP : GemItem) {
	superCategory = "gems";
	category = "PQUP";

	shapeFile = "~/data/shapes_pqup/gems/customGem.dts";
