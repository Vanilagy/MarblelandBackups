datablock AudioDescription(AudioCustomCollision3d) {
   volume   = 1.0;
   isLooping = false; // <--- ESTO ES LO MÁS IMPORTANTE
   is3D      = false;
   ReferenceDistance = 10.0;
   MaxDistance       = 50.0;
   type      = 4; // Tipo de efecto de sonido (SFX)
};
datablock AudioProfile(BUMPER) {
	filename    = "~/data/shapes/pinball/Bumper.ogg";
	description = AudioCustomCollision3d;
	preload = true;
};
datablock AudioProfile(BONK) {
	filename    = "~/data/shapes/pinball/BONK.ogg";
	description = AudioCustomCollision3d;
	preload = true;
};
function fxLightData::create(%data)
{
   // The mission editor invokes this method when it wants to create
   // an object of the given datablock type.
   %obj = new fxLight() {
      dataBlock = %data;
   };
   return %obj;
}
datablock fxLightData(FlameLight)
{
   category = "fxLights";

   // Dynamic light
   LightOn = true;
   Radius = 20.0;
   Brightness = 1.0;
   Colour = "1 1 1";
   FlareOn = true;
   FlareTP = true;
   FlareBitmap = "common/lighting/corona";
   FlareColour = "1 1 0.5";
   ConstantSizeOn = false;
   ConstantSize = 0.2;
   NearSize = 0.5;
   FarSize = 0.2;
   NearDistance = 10.0;
   FarDistance = 30.0;
   FadeTime = 0.1;
   BlendMode = 0;
   LinkFlare = true;
   LinkFlareSize = false;
};
