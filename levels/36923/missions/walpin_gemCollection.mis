//--- OBJECT WRITE BEGIN ---
new SimGroup(MissionGroup) {

   new ScriptObject(MissionInfo) {
         artist = "JRubik";
         awesomeHint = "Help an experienced player master your level!";
         customRadarRule = "0";
         desc = "(original track by Nintendo) Waluigi Pinball from Mario Kart Ds";
         eastereggHint = "Help the player find the Easter Egg! If you choose to place one, of course.";
         eggHint = "This field is for PQ levels, which this level is not.";
         game = "Gold";
         gameMode = "null";
         generalHint = "Help the player beat your level!";
         level = "2";
         music = "DS Wario Stadium  DS Waluigi Pinball.ogg";
         name = "Waluigi Pinball(Gem collection mode)";
         startHelpText = "3, 2, 1, GO!!";
