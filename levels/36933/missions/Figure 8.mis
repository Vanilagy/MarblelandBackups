// @include "~/data/shapes/Figure_8/particle1.png"
// @include "~/data/README.txt"
// @include "~/data/AUDIO INSTRUCTIONS.txt"
// @include "~/data/sound/music/Figure-8 Mario Circuit.json"
datablock StaticShapeData(tree2) {
	className = "tree2";
	superCategory = "Figure 8";
	shapeFile = "~/data/shapes/Figure_8/alpha_tree.dts";
};
function syncObjectWithCamera(%obj) {
    if (!isObject(%obj)) {
        return;
    }

    %camera = 0;
    if (isObject(LocalClientConnection)) {
        %camera = LocalClientConnection.getCameraObject();
    }
    
    if (!isObject(%camera) && isObject(ServerConnection)) {
        %camera = ServerConnection.getControlObject();
    }

    if (isObject(%camera)) {
        // 1. Obtener la posición actual del objeto
        %objPos = getWords(%obj.getTransform(), 0, 2);

        // 2. Obtener el vector hacia adelante (forward vector) de la cámara
        %forwardVector = %camera.getForwardVector();

        // 3. Proyectar en el plano XY (ignorar inclinación vertical arriba/abajo)
        %fX = getWord(%forwardVector, 0);
        %fY = getWord(%forwardVector, 1);

        // 4. Calcular el ángulo en radianes usando arcotangente
        if (%fX == 0 && %fY == 0) {
            %angle = 0;
        } else {
            // mAtan opera en (Y, X) en Torque y devuelve radianes
            %angle = mAtan(%fX, %fY); 
        }

        // 5. Crear la nueva transformación orientada en el eje Z
        %newTrans = %objPos @ " 0 0 1 " @ %angle;

        // 6. Aplicar de forma forzada
        %obj.setTransform(%newTrans);
    }

    // Mantener el bucle de sincronización
    %obj.cameraSyncSchedule = schedule(16, %obj, "syncObjectWithCamera", %obj);
}

function cancelCameraSync(%obj) {
    if (isObject(%obj) && %obj.cameraSyncSchedule !$= "") {
        cancel(%obj.cameraSyncSchedule);
        %obj.cameraSyncSchedule = "";
    }
}


function tree2::onAdd(%this, %obj) {
    // Esperar un instante a que el objeto se cargue completamente en la escena
    schedule(100, %obj, "syncObjectWithCamera", %obj);
}

function tree2::onRemove(%this, %obj) {
    cancelCameraSync(%obj);
}

datablock ParticleData(BreakingParticle) {
   dragCoefficient = "0";
   windCoefficient = "0";
   gravityCoefficient = "1";
   inheritedVelFactor = "0";
   constantAcceleration = "-2";
   lifetimeMS = "480";
   lifetimeVarianceMS = "96";
   spinSpeed = "90";
   spinRandomMin = "-90";
   spinRandomMax = "90";
   useInvAlpha = "1";
   animateTexture = "0";
   framesPerSec = "1";
   textureName = "platinum/data/shapes/Figure_8/particle1.png";
   animTexName[0] = "platinum/data/shapes/Figure_8/particle1.png";
   colors[0] = "1 1 1 1";
   colors[1] = "1 1 1 1";
   colors[2] = "1 1 1 0";
   colors[3] = "1 1 1 1";
   sizes[0] = "1";
   sizes[1] = "1";
   sizes[2] = "1";
   sizes[3] = ".5";
   times[0] = "0";
   times[1] = "0.74902";
   times[2] = "1";
   times[3] = "2";
      dragCoeffiecient = "1";
};
 
//--- Emitter ---
datablock ParticleEmitterData(BreakingBoxEmiter) {
   className = "ParticleEmitterData";
   ejectionPeriodMS = "10";
   periodVarianceMS = "0";
   ejectionVelocity = "8";
   velocityVariance = "1.5";
   ejectionOffset = "0";
   thetaMin = "0";
   thetaMax = "129.6";
   phiReferenceVel = "1000";
   phiVariance = "360";
   overrideAdvance = "0";
   orientParticles = "0";
   orientOnVelocity = "1";
   particles = "BreakingParticle";
   lifetimeMS = "75";
   lifetimeVarianceMS = "0";
   useEmitterSizes = "0";
   useEmitterColors = "0";
   noHide = "0";
};
datablock AudioDescription(AudioCustomCollision3d) {
   volume   = 1.0;
   isLooping = false; 
   is3D      = false;
   ReferenceDistance = 10.0;
   MaxDistance       = 50.0;
   type      = 4; 
};
datablock AudioProfile(BreakingBox) {
	filename    = "~/data/shapes/Figure_8/box.wav";
	description = AudioCustomCollision3d;
	preload = true;
};
datablock StaticShapeData(skyModel) {
	className = "skyModel";
	superCategory = "Figure 8";
	shapeFile = "~/data/shapes/Figure_8/sky.dts";
	shadowEnable = true;
};
function skyModel::onAdd(%this, %obj){
	%obj.playThread(0, "Sky");
}

datablock ItemData(RandomItemBox : RandomPowerUpItem) {
   superCategory = "Figure 8";
   className = "RandomItemBox";
   shapeFile = "~/data/shapes/Figure_8/Box.dts";
   mass = 1;
   friction = 1;
   elasticity = 0.3;
   emap = false;
   
   // Desactiva por completo la rotación automática nativa del motor
   rotate = "0"; 

   noRespawn = false;
   maxInventory = 1;

   // Campos personalizados existentes...
   customField[0, "field" ] = "showHelpOnPickup";
   customField[0, "type" ] = "boolean";
   customField[0, "name" ] = "Show Help Message";
   customField[0, "desc" ] = "If the player should see a help message for how to use the PowerUp when they collect it.";
   customField[0, "default"] = "0";
   customField[1, "field" ] = "timeBonus";
   customField[1, "type" ] = "time";
   customField[1, "name" ] = "Time Bonus";
   customField[1, "desc" ] = "Bonus time to add if the Random PowerUp gives you a Time Travel.";
   customField[1, "default"] = $Game::TimeTravelBonus;
};

// onAdd maneja la animación personalizada que creaste en Blender
function RandomItemBox::onAdd(%this, %obj){
   // Asegura que no rote de forma nativa al aparecer en el mapa
   %obj.rotate = "0";
   // Esto inicia tu animación personalizada llamada "BOX" desde el .dts de Blender
   %obj.playThread(0, "BOX"); 
}

function RandomItemBox::OnPickup(%this, %obj, %user, %amount) {
   // 1. OBTENER LA POSICIÓN EXACTA DE LA CAJA
   %pos = %obj.getPosition();

   // 2. CREACIÓN DEL EMISOR ADAPTADO A TU EMITTER CUSTOM
       // 2. CREACIÓN DEL EMISOR ADAPTADO
   %emitter = new ParticleEmitterNode() {
      datablock = MPEmitterNode; // Cambiado a la clase estándar de MB
      emitter = BreakingBoxEmiter; 
      position = %pos;
   };
   MissionCleanup.add(%emitter);
   %emitter.schedule(350, "delete");


   // 3. REEMPLAZO DE AUDIO (Tu configuración original)
   %user.client.play2D(BreakingBox);

   // 4. Código original de selección de items de Platinum Quest...
   if (MissionInfo.game $= "PlatinumQuest")
      %pupIdx = getRandom(1, 5);
   else
      %pupIdx = getRandom(1, 6);

   switch (%pupIdx) {
      case 1: %pup = SuperJumpItem;
      case 2: %pup = SuperSpeedItem;
      case 3: %pup = HelicopterItem;
      case 4: %pup = SuperBounceItem;
      case 5: %pup = ShockAbsorberItem;
      case 6: return TimeTravelItem::onPickup(%this, %obj, %user, %amount);
   }

   if (MissionInfo.game $= "PlatinumQuest")
      %pup = %pup @ "_PQ";

   return PowerUp::OnPickup(%pup.getId(), %obj, %user, %amount);
}



