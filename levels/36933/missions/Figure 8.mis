datablock StaticShapeData(tree) {
	className = "tree";
	superCategory = "Figure 8";
	shapeFile = "~/data/shapes/Figure_8/alpha_tree.dts";
	shadowEnable = true;
};
function syncObjectRotationWithCamera(%shapeId)
{
    if (!isObject(%shapeId))
        return;

    %client = LocalClientConnection;
    if (isObject(%client))
    {
        %controlObj = %client.getControlObject();
        if (isObject(%controlObj))
        {
            %shapePos = %shapeId.getPosition();
            %targetPos = "";

            if (%controlObj.getClassName() $= "Marble")
            {
                %targetPos = %controlObj.getPosition();
            }
            else
            {
                %targetPos = getWords(%controlObj.getTransform(), 0, 2);
            }

            if (%targetPos !$= "")
            {
                %dirX = getWord(%targetPos, 0) - getWord(%shapePos, 0);
                %dirY = getWord(%targetPos, 1) - getWord(%shapePos, 1);

                if (%dirX == 0 && %dirY == 0)
                    %dirY = 0.1;

                // --- CÁLCULO HORIZONTAL (Yaw) ---
                %yaw = mAtan(%dirX, %dirY);

                // CORRECCIÓN MATEMÁTICA DEL EJE HORIZONTAL
                if (%controlObj.getClassName() $= "Marble")
                {
                    %yaw = (-%yaw) + 3.14159265;
                }
                else
                {
                    // Ajuste para el modo cámara libre
                    %yaw = -%yaw;
                }

                // --- FORZAR EJE VERTICAL EN 0 ---
                %pitch = 0; 

                // Creamos la matriz combinada (Pitch en 0, Roll en 0, Yaw corregido)
                %eulerRot = %pitch SPC "0" SPC %yaw;
                %matrix = MatrixCreateFromEuler(%eulerRot);
                %finalRot = getWords(%matrix, 3, 6);

                %shapeId.setTransform(%shapePos SPC %finalRot);
            }
        }
    }

    %shapeId.cameraSyncSchedule = schedule(8, %shapeId, "syncObjectRotationWithCamera", %shapeId);
}

function tree::onAdd(%this, %obj)
{
    syncObjectRotationWithCamera(%obj);
}

function tree::onRemove(%this, %obj)
{
    // Limpieza para evitar fugas de memoria al destruir el objeto
    cancel(%obj.cameraSyncSchedule);
}

