new SimGroup(MissionGroup) {

   new ScriptObject(MissionInfo) {
         artist = "Jaxx";
         awesomeHint = "No mistakes whatsoever, and carelul routing as well.";
         awesomeTime = "65000";
         customRadarRule = "63";
         desc = "Drop down between these colorful floors while looting for gems!!";
         eggHint = "There\'s a sneaky button somewhere around..... Pressing it causes something magical to happen........";
         forceRadar = "1";
         game = "PlatinumQuest";
         gameMode = "null";
         generalHint = "Pay attention to how many gems are on a floor when you first drop down to one! In case you somehow miss some, they are all colored based on the floor so the radar can help you there too.";
         music = "Maze.ogg";
         name = "Colorful Twist";
         platinumTime = "90000";
         radar = "1";
         startHelpText = "Floor 0: Introduction (2 gems)";
         trivia = "Development started about a year ago, when there were a decent amount of levels stylized around \"Tri Twist\" from MBG being uploaded. Like always with my levels, it remained unfinished for a long time until I randomly decided to pick it back up and complete it! The colorful aesthetic just comes from me loving colors so much, nothing special there.";
         type = "Custom";
         ultimateHint = "Each floor (except for the first and last) have a 5 second time travel hidden somewhere, some in sneaky spots even!";
         ultimateTime = "70000";
   };
