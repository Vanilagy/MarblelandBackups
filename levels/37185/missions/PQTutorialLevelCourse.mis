         artist = "charlemaniac";
         awesomeHint = "If you run the level real fast with no fails you should be able to do it given the right strategies and paths for the areas which require pathfinding.";
         awesomeTime = "480000";
         customRadarRule = "0";
         desc = "Every PQ Tutorial Level! (There are 14 nest eggs)";
         easterEggHint = "1: Where it is in Training Eh... 2: Tiny triangle hole. 3: Nuke wall. 4: Under the space box. 5: Bottom of Gems. 6: The usual beam. 7: Gravifly underneath FoP. 8: Uphill Skipping. 9: Hidden Locomotion flip. 10: Conserve SJ from Locomotion water pool. 11: On a beam under the racetrack. 12: High nature reserve. 13: High-speed loop exit. 14: Perilous wireframe.";
         game = "PlatinumQuest";
         gameMode = "null";
         generalHint = "There are many checkpoints, so falling off is really no biggie. No time travels either, so just get all the gems.";
         level = "1000";
         music = "Reanimation.ogg";
         name = "Tutorial Course";
         noBlast = "1";
         platinumTime = "1200000";
         radar = "1";
         startHelpText = "Start it here.";
         trivia = "Level created on July 6, 2022\nUpdates:\nMarch 12, 2026 - Added bounds to first area.\nMarch 13, 2026 - Added bounds to second area.\nMarch 14, 2026 - Added bounds to third area. The problem is, the third area is diagonal, and I didn\'t know diagonal bounds don\'t work. That will have to be fixed eventually.\nMarch 28, 2026 - Attempted to fix the problem noted above. Ended up adding WAY too many little OOB triggers. It took like 20-30 seconds just to save. And it\'s only for 1 wall!\nAugust 3, 2026 - Finally fixed the OOB triggers in the third area. Yes it looks very silly and there may be a way to miss the OOB triggers there, but this will do.\nAugust 7, 2026 - Added challenge times, hints, and trivia.\nAugust 7, 2026 - Added camera path and icon picture.\nAugust 12, 2026 - Changed existing help bubbles and added a lot of new ones.\nTrivia:\nOne of my longer levels. And one that took more effort to refurbish. Anyway, I don\'t recall why I added the nest eggs in this one, but they\'re kind of a gimmick of this level in particular. The string of interiors at the end are ones I found to be supplementary to the levels (smaller).";
         type = "Custom";
         ultimateHint = "Careful of shortcuts; there are some OOB triggers around this level. However shortcuts and timesaves within an interior are perfectly acceptable.";
         ultimateTime = "720000";
   };
