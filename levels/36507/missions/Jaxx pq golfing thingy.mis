new SimGroup(MissionGroup) {

   new ScriptObject(MissionInfo) {
         artist = "Jaxx";
         awesomeHint = "This is a very tight one. Both time travels are required as well as speedy movement at all times.";
         awesomeTime = "32250";
         customRadarRule = "0";
         desc = "What a beautiful golf course high up in the sky!!";
         eggHint = "You will have to get on something first before going somewhere else.....";
         game = "PlatinumQuest";
         gameMode = "null";
         generalHint = "Avoid trying to go for any shortcuts available when first playing, as most of them lead to out of bounds.";
         hideRadar = "1";
         jumpImpulse = "4";
         music = "Lakebed.ogg";
         name = "Marble Mini Golf: Sky High Sprint";
         platinumTime = "50000";
         startHelpText = "As a golf marble, your jump height is much weaker than a normal marble.";
         trivia = "This I believe is currently the only PQ golf custom level out there, except if you count Golfer\'s Puzzle lol. This level also had development around December 2025 however a major issue was around causing the elevator to make the marble bounce and even sink through it.";
         type = "Custom";
         ultimateHint = "You can use the wooden railings to your advantage!! It can help prevent you from falling off before the mud as well as use it to quickly turn around on the island with the button!!";
         ultimateTime = "34000";
   };
