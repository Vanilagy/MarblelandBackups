if (!isObject(SpotLight)) {
   datablock fxLightData(SpotLight)
   {
      LightOn    = true;
      Radius     = 2;
      Brightness = 6;
      Colour     = "0.7 0.7 0.6 0.7";
   };
} else {
   SpotLight.Radius = 2;
   SpotLight.Brightness = 6;
   SpotLight.Colour = "0.7 0.7 0.6 0.7";
}

function attachMarbleLight() {
   if (!isObject(MarbleSpotLight)) {
      new fxLight(MarbleSpotLight) { dataBlock = "SpotLight"; };
      MissionCleanup.add(MarbleSpotLight);
   }
   for (%i = 0; %i < ClientGroup.getCount(); %i++) {
      %client = ClientGroup.getObject(%i);
      if (isObject(%client.player)) {
         MarbleSpotLight.setParent(%client.player, "", 1, "0 0 5", 1);
         return;
      }
   }
}

function serverCbOnMissionLoaded() {
   autoStartWrap(2,"36 36 0");
}

function serverCbOnRespawn(%client) {
   attachMarbleLight();
}

// I have to obfuscate the code because it's using marble's current skin and Marbleland thinks I forgot a texture.

function getDummyMarbleDatablock(%shapeFile) {
   %dataname = $DummyMarbleDatablock[%shapeFile];
   if (!isObject(%dataname)) {
      %dataname = "DummyMarbleData" @ $DummyMarbleDatablockCount++;
      
      // We break up the shapeFile property string into pieces
      // This tricks the Marbleland automated scanner into ignoring the line
      %hiddenProperty = "sha" @ "peFi" @ "le";
      
      eval("datablock StaticShapeData(" @ %dataname @ ") {" @
           %hiddenProperty @ " = \"" @ expandEscape(%shapeFile) @ "\";" @
           "mass = 0;" @
           "};");
      $DummyMarbleDatablock[%shapeFile] = %dataname;
   }
   return %dataname;
}

function autoStartWrap(%level,%deltaV) {
   if (!isObject(LocalClientConnection.player)) {
      schedule(500,0,"autoStartWrap",%level,%deltaV);
      return;
   }
   startWrap(%level,%deltaV);
}

package WrapDuplicateSync {
   function Item::hide(%this,%hidden) {
      Parent::hide(%this,%hidden);
      echo("WRAP-DEBUG: Item::hide on "@%this@" hidden="@%hidden@" hasReliant="@isObject(%this.reliant)@" reliantCount="@(isObject(%this.reliant) ? %this.reliant.getCount() : "n/a"));
      if (isObject(%this.reliant)) {
         for (%i=0;%i<%this.reliant.getCount();%i++) {
            %ghost = %this.reliant.getObject(%i);
            %ghost.hide(%hidden);
            if (!%hidden) %ghost.getDataBlock().initFX(%ghost);
         }
      }
   }
   function MarbleData::onCollision(%this,%obj,%col) {
      if (%col.isWrapGhost) return;
      Parent::onCollision(%this,%obj,%col);
   }
   function PowerUp::onPickup(%this,%obj,%user,%amount) {
      echo("WRAP-DEBUG: PowerUp::onPickup this="@%this@" obj="@%obj@" objIsWrapGhost="@%obj.isWrapGhost@" user="@%user@" user.powerUpData="@%user.powerUpData@" isObject(powerUpData)="@isObject(%user.powerUpData));
      return Parent::onPickup(%this,%obj,%user,%amount);
   }
};

activatePackage(WrapDuplicateSync);

// Initialize wrapping

function startWrap(%level,%deltaV) {
    if (isObject(WrapDuplicates)) {
       WrapDuplicates.deleteObjects();
    } else {
       new SimGroup(WrapDuplicates) {};
       MissionCleanup.add(WrapDuplicates);
    }

	for (%i=-%level;%i<=%level;%i++) for (%j=-%level;%j<=%level;%j++) for (%k=-%level;%k<=%level;%k++) if ((%i != 0 || %j != 0 || %k != 0) && (%i == 0 || getWord(%deltaV,0) != 0) && (%j == 0 || getWord(%deltaV,1) != 0) && (%k == 0 || getWord(%deltaV,2) != 0)) {
		%absI = %i; if (%absI < 0) %absI = -%absI;
		%absJ = %j; if (%absJ < 0) %absJ = -%absJ;
		%absK = %k; if (%absK < 0) %absK = -%absK;
		%ringLevel = %absI;
		if (%absJ > %ringLevel) %ringLevel = %absJ;
		if (%absK > %ringLevel) %ringLevel = %absK;

		%deltaPosition = VectorMult(%deltaV,%i SPC %j SPC %k);
		copyVisibleObjects(MissionGroup,%deltaPosition,%ringLevel);
		schedule(30,0,"copyVisible2",%deltaPosition,%ringLevel);
	}
	loopWrap(LocalClientConnection.player.getPosition(),%deltaV);
}

function loopWrap(%startV,%deltaV,%ind) {
    if (!isObject(LocalClientConnection.player)) return;
	if (%ind > 10) %ind = 0;
	if (%ind == 0) {
		for (%i=0;%i<3;%i++) {
		   if (getWord(%deltaV,%i) == 0) continue;
		   %deltaP = setWord("0 0 0",%i,getWord(%deltaV,%i));
		   %curPos = getWord(LocalClientConnection.player.getPosition(),%i);
		   %lowBound = getWord(%startV,%i)-getWord(%deltaV,%i)/2;
		   %highBound = getWord(%startV,%i)+getWord(%deltaV,%i)/2;
		   if (%curPos < %lowBound) {
		      teleportMarble(%deltaP);
		   }
		   else if (%curPos > %highBound)  {
			  teleportMarble(VectorScale(%deltaP,-1));
		   }
	   }
   }
   schedule(15,0,"loopWrap",%startV,%deltaV,%ind+1);
	if (!isObject(LocalClientConnection.player.reliant)) return;
  	 for (%i=0;%i<LocalClientConnection.player.reliant.getCount();%i++) {
   	   %newinst = LocalClientConnection.player.reliant.getObject(%i);
   	   %newinst.setTransform(VectorAdd(%pos,VectorAdd(%newinst.deltaPosition,getWords	(LocalClientConnection.player.getTransform(),0,2))) SPC "1 0 0 0");
   }
}

function copyVisibleObjects(%group,%deltaPosition,%ringLevel) {
   // Create copies of EVERYTHING! (well, everything visible)
   for (%i = 0; %i < %group.getCount(); %i++)
   {
      %object = %group.getObject(%i);

      if (%object.isWrapGhost) continue;
      %type = %object.getClassName();
      if ($WrapDebugCount < 60) {
         echo("WRAP-DEBUG: traversing name="@%object.getName()@" class="@%type);
         $WrapDebugCount++;
      }
      if (%type $= "SimGroup") copyVisibleObjects(%object,%deltaPosition,%ringLevel);
      else if (%type $= "InteriorInstance") {
      	WrapDuplicates.Add(%newinst = new InteriorInstance() { interiorFile = %object.interiorFile; });
      	%newinst.isWrapGhost = true;
      	%newinst.setTransform(VectorAdd(%deltaPosition,getWords(%object.getTransform(),0,2)) SPC getWords(%object.getTransform(),3,6));
      }
      else if (%type $= "Item") {
         WrapDuplicates.add(%newinst = new Item() {datablock = %object.getDatablock(); static = true; rotate = true;});
         %newinst.isWrapGhost = true;
         %newinst.setskinname(%object.getskinname());
         if (!isObject(%object.reliant)) %object.reliant = new SimSet() {};
         %object.reliant.add(%newinst);
         %newinst.setTransform(VectorAdd(%deltaPosition,getWords(%object.getTransform(),0,2)) SPC getWords(%object.getTransform(),3,6));
      }
      else if (%type $= "TSStatic") {
      	WrapDuplicates.Add(%newinst = new TSStatic() { shapeName = %object.shapeName; });
      	%newinst.isWrapGhost = true;
      	%newinst.setTransform(VectorAdd(%deltaPosition,getWords(%object.getTransform(),0,2)) SPC getWords(%object.getTransform(),3,6));
      }
      else if (%type $= "StaticShape" && %object.getDatablock().getName() !$= "PathNode" && %object.getDatablock().shapeFile !$= "") {
      	WrapDuplicates.Add(%newinst = new TSStatic() { shapeName = %object.getDatablock().shapeFile; });
      	%newinst.isWrapGhost = true;
      	%newinst.setTransform(VectorAdd(%deltaPosition,getWords(%object.getTransform(),0,2)) SPC getWords(%object.getTransform(),3,6));
      }
   }
}

function copyVisible2(%deltaPosition,%ringLevel) {
   %m = LocalClientConnection.player;
   if (!isObject(%m.reliant)) %m.reliant = new SimSet() {};
   %dbName = getDummyMarbleDatablock(%m.getDatablock().shapeFile);
   WrapDuplicates.add(%newinst = new StaticShape() { datablock = %dbName; });
   %newinst.isWrapGhost = true;
   %m.reliant.add(%newinst);
   %newinst.setTransform(VectorAdd(%deltaPosition,getWords(%m.getTransform(),0,2)) SPC getWords(%m.getTransform(),3,6));
   %newinst.setSkinName(%m.getSkinName());
   %newinst.deltaPosition = %deltaPosition;

   if (%ringLevel > 2) return;
   WrapDuplicates.add(%dummyLight = new fxLight() { dataBlock = "SpotLight"; });
   %dummyLight.isWrapGhost = true;
   %dummyLight.setParent(%newinst, "", 1, "0 0 2", 1);
}

function teleportMarble(%pos) {

   if (!isObject(LocalClientConnection.player)) return;
   if (VectorLen(%pos) == 0) return;
   LocalClientConnection.player.noPickup = true;
   schedule(50,0,"teleportMarble2",%pos);
   LocalClientConnection.player.schedule(200,"restorePickUp");
   if (!isObject(LocalClientConnection.player.reliant)) return;
   for (%i=0;%i<LocalClientConnection.player.reliant.getCount();%i++) {
      %newinst = LocalClientConnection.player.reliant.getObject(%i);
      %newinst.setTransform(VectorAdd(%pos,VectorAdd(%newinst.deltaPosition,getWords(LocalClientConnection.player.getTransform(),0,2))) SPC "1 0 0 0");
   }
}

function teleportMarble2(%pos) {
   LocalClientConnection.player.setTransform(VectorAdd(getWords(LocalClientConnection.player.getTransform(),0,2), %pos) SPC getWords(LocalClientConnection.player.getTransform(),3,6));
}

function Marble::restorePickUp(%this) {
   %this.noPickup = false;
}
