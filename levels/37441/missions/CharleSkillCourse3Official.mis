   new ScriptObject(MissionInfo) {
         artist = "charlemaniac";
         awesomeHint = "Start with the text; it is very difficult. You\'ll need to skim many gems and time travels at once with each fly/jump. Then smuggle a gyrocopter and use it on the start pillar for the pipe pathway to easily get the two time travels. Fly off the start pad edge up to the cake, then super jump bumper hit to the candles.";
         awesomeTime = "52000";
         customRadarRule = "0";
         desc = "Explore some more interiors!";
         game = "Platinum";
         gameMode = "null";
         generalHint = "Try not to tread too far into the danger zone for the fans, magnets, and tornadoes on the birthday cake.If you need to, you can use the checkpoints at the bottom aggressively.";
         hideRadar = "1";
         level = "1000";
         music = "Rising Temper.ogg";
         name = "Charlemaniac\'s Put-Together Skill Course 3";
         noBlast = "1";
         platinumTime = "180000";
         startHelpText = "Let\'s start with a choose-your-challenge situation.";
         trivia = "Original level created on December 17, 2026\nModified version created on August 29, 2026\nModifications:\n- Remade entire level.\nTrivia:\nYes, this level uses the same interiors as the original, just put together in a way I consider better. Many parts are completely new and different, and that\'s okay.";
         type = "Custom";
         ultimateHint = "You can use one gyrocopter to get 22 seconds of time travel at once on Beach Party, and you can route the brawl effectively to retain much of your TT time throughout it.";
