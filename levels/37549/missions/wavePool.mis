// @include "~/data/shapes_pqup/gems/bm_gate_gem.png"

datablock ItemData(GemItemPQUP : GemItem) {
	superCategory = "gems";
	category = "PQUP";

	shapeFile = "~/data/shapes_pqup/gems/customGem.dts";
	skin[0] = "base";
	skin[1] = "purple";
	skin[2] = "red";
	skin[3] = "orange";
	skin[4] = "black";
	skin[5] = "pink";
	skin[6] = "green";
	skin[7] = "platinum";
	skin[8] = "blue";
   skin[9] = "yellow";
	
	pickupName = "a gem!";

	fxEmitter[0] = "GemEmitter";

	customField[0, "field"  ] = "skin";
	customField[0, "type"   ] = "string";
	customField[0, "name"   ] = "Skin Name";
	customField[0, "desc"   ] = "Which skin color to use (see skin selector.)";
	customField[0, "default"] = "";
};

datablock ItemData(GemItemGatePQUP : GemItemPQUP) {
	superCategory = "gems";
	category = "PQUP";

 	skin = "purple";
	shapeFile = "~/data/shapes_pqup/gems/gemGate.dts";
};

datablock ItemData(GemItemPQUP : GemItem) {
	superCategory = "gems";
	category = "PQUP";

 	skin = "purple";
	shapeFile = "~/data/shapes_pqup/gems/customGem.dts";
};
// stolen from PQ's scripts
datablock ItemData(TimeTravelItemPQUP : TimeTravelItem) {
	// Mission editor category
	superCategory = "PowerUps";
	category = "PQUP";

	// Basic Item properties
	pickupAudio = nothing;
	shapeFile = "~/data/shapes_pqup/powerups/timetravel.dts";
	mass = 1;
	friction = 1;
	elasticity = 0.3;
	emap = false;

	// Dynamic properties defined by the scripts
	noRespawn = true;
	maxInventory = 1;
	noPickupMessage = true;

	//For ::timeCheck() to replace if the time is negative
	replacement = "TimePenaltyItem";

	//For the time message
	messageColor = "99ff99";
	grayMessageColor = "cccccc";

	customField[0, "field"  ] = "timeBonus";
	customField[0, "type"   ] = "time";
	customField[0, "name"   ] = "Time Bonus";
	customField[0, "desc"   ] = "Bonus time to add.";
	customField[0, "default"] = $Game::TimeTravelBonus;
};

datablock ItemData(TimeTravelItem_PQ : TimeTravelItem) {
	shapeFile = "~/data/shapes_pq/Gameplay/Powerups/timetravel.dts";

	//For ::timeCheck() to replace if the time is negative
	replacement = "TimePenaltyItem_PQ";
};

datablock ItemData(TimeTravelItemGatePQUP : TimeTravelItem) {
	superCategory = "PowerUps";
	category = "PQUP";

 	skin = "purple";
	shapeFile = "~/data/shapes_pqup/powerups/powerupGate.dts";
};

datablock ItemData(gateCorner : gateCorner) {
	superCategory = "scenery";
	category = "PQUP";

	shapeFile = "~/data/shapes_pqup/gems/gateCorner.dts";
};

