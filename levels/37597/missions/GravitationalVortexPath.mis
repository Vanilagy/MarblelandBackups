   new ScriptObject(MissionInfo) {
         artist = "charlemaniac";
         awesomeHint = "See how the level only has five gems? Start your path off by jumping straight to the 10-second time travel and go from there.";
         awesomeTime = "16000";
         customRadarRule = "47";
         desc = "Make it to the end safely.";
         easterEggHint = "Don\'t rush to climb those steps; have a look around. See if you missed something.";
         game = "PlatinumQuest";
         gameMode = "null";
         generalHint = "Generally go into gravity modifiers slowly if it\'s unclear where you\'ll end up. The last one is an exception; don\'t roll into it slowly or you\'ll die! Also, make sure to read the help text.";
         level = "1000";
         music = "Racing Forever.ogg";
         name = "Gravitational Path";
         noBlast = "1";
         platinumTime = "96000";
         radar = "1";
         startHelpText = "Start by flipping upside-down.";
         trivia = "Level created on October 30, 2025\nUpdates:\nMarch 8, 2026 - Added bounds.\nSeptember 19, 2026 - Added camera path, icon picture, challenge times, hints, and trivia.\nSeptember 24, 2026 - Changed platinum and ultimate times.\nTrivia:\nThis was an interesting level to make. Similar to Powerup Training Facility this was quite revolutionary, and especially in the fact that I really discovered that modifying the position values of trapdoors can let you build smooth bridges of them. Not quite all the other alignment related tech, I\'d figure that out later. But this is still a very interesting level. Similar also to Powerup Facility, I designed the level around the awesome route.";
         type = "Custom";
         ultimateHint = "Time travels. They\'re helpful!";
         ultimateTime = "67500";
   };
