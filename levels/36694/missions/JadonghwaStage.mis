// Adjustable Dials

datablock StaticShapeData(DialWood) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/DialWood.dts";

	customField[0, "field"  ] = "dposition";
	customField[0, "type"   ] = "int";
	customField[0, "name"   ] = "Digit Position";
	customField[0, "desc"   ] = "The digit position of the password. Must be a power of 8 (1, 8, 64, etc) for Jadonghwa wooden dials.";
	customField[0, "default"] = "";
};

function DialWood::onCollision(%this, %obj) {
	// Rotates the dial depending on the current state, implemented via a chain of IF-ELSE
	if (%obj._currentSkin == 0) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 1) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 2) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 3) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 4) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 5) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 6) {
		%obj._currentSkin += 1;
		$JadonghwaPass += %obj.dposition;
	}
	else if (%obj._currentSkin == 7) {
		%obj._currentSkin = 0;
		$JadonghwaPass -= (%obj.dposition * 7);
	}
	// Code to be executed regardless of the IF statements
	%obj.setSkinName(%obj._currentSkin);
	// TODO ON UPLOAD: This line should be commented or removed upon release
	ECHO($JadonghwaPass);
}

function DialWood::onMissionReset(%this, %obj) {
	$JadonghwaPass = 0;
	%obj._currentSkin = 0;
	%obj.setSkinName(0);
}

// The unlocker

datablock AudioProfile(FlowerBtnTwoSfx) {
	filename    = "~/data/sa_assets/Jadonghwa/Sounds/jdh_sw_2.wav";
	description = AudioDefault3d;
	preload = true;
};

datablock StaticShapeData(DialUnlock) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/DialUnlock.dts";

	customField[0, "field"  ] = "required";
	customField[0, "type"   ] = "int";
	customField[0, "name"   ] = "Required Number";
	customField[0, "desc"   ] = "The password required for unlocking.";
	customField[0, "default"] = "";
	customField[1, "field"  ] = "objectToHide";
	customField[1, "type"   ] = "string";
	customField[1, "name"   ] = "Object to Hide";
	customField[1, "desc"   ] = "The object to hide upon unlock.";
	customField[1, "default"] = "";
};

function DialUnlock::onCollision(%this, %obj) {
	// Unlocks the door when the password is correct
	if (($JadonghwaPass == %obj.required) && (%obj._active == 0)) {
		// Not really sure whether this is important or not
		%obj._active = 1;
		%obj.playThread(0,"a");
		%obj.playAudio(0, FlowerBtnTwoSfx);

		//Unlocks the door.
		%obj.objectToHide.hide(true);
	}
}

function DialUnlock::onMissionReset(%this, %obj) {
	%obj._active = 0;
	%obj.objectToHide.hide(false);

	%obj.playThread(0,"a");
	%obj.stopThread(0);
}

