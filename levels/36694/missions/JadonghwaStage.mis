// Now this mission file actually begins.

//--- OBJECT WRITE BEGIN ---
new SimGroup(MissionGroup) {

   new ScriptObject(MissionInfo) {
         artist = "SummerArmy";
         awesomeHint = "Have you considered skipping the pink flower switch too?";
         awesomeTime = "120000";
         customRadarRule = "0";
         desc = "After discovering that RandomityGuy had been whisked into a different realm of his nightmare, you were forced to flee the high-life metropolis via a levitation beacon. You soon found yourself in a purple, romantic-looking forest dimension, teeming with strange trees and floral life. Until the mechanics of the spatial rifts are understood, it remains a mystery how you arrived in the heart of this cosmic forest--and whether RandomityGuy is truly trapped within its depths.";
         eggHint = "Like in Pathfinding Ingenuity, this Nest Egg (don\'t confuse it with the striped eggs) is easy to spot, yet hard to actually reach. So... have you explored more of the trees around you?";
         game = "PlatinumQuest";
         generalHint = "Stay nimble! You\'ll need quick reflexes to navigate these moving platforms. And a word of warning: a few of those cosmic flowers might remind you of the bumpers and duct fans from Marble Blast. Don\'t let them catch you off guard--or better yet, use them to your advantage whenever the situation allows.\n\nTip: After hitting the moving target halfway through the level, you might as well find a cool shortcut with ease. It will be important for beating challenge times such as the Platinum Time, so keep it in mind!";
         level = "1000";
         music = "Chabunhan Calmness.ogg";
         name = "Jadonghwa Jungle";
         platinumTime = "180000";
         radar = "1";
         startHelpText = "Does this gauntlet feel familiar to you?";
         trivia = "Originally, this level had a realistic, orange, autumn-like atmosphere. However, to better complement its purple flowers, it was changed to a purple, cosmic fantasy theme. Back then, those flowers even had green stems instead of the current purple ones.\n\nThis is also my first level to use some of the free PBR textures from ambientCG. Specifically, Ground095A, Ground079L, Grass001, Grass008, WoodFloor051, Wood058, and Bark014 have been used.";
         type = "Custom";
         ultimateHint = "Time Travels in this level have different colors depending on the time bonuses they give. The darker the shade of purple, the longer the time bonus. Nonetheless, finding the right cycles of the moving platforms is crucial for planning the route. Seriously, don\'t forget that aforementioned shortcut!";
         ultimateTime = "150000";
   };
   new SimGroup(MissionData) {

      new Sky(Sky) {
         position = "336 136 0";
         rotation = "1 0 0 0";
         scale = "1 1 1";
         materialList = "platinum/data/sa_assets/Jadonghwa/Skies/JadonghwaSkybox/jadonghwa.dml";
         cloudHeightPer[0] = "0";
         cloudHeightPer[1] = "0";
         cloudHeightPer[2] = "0";
         cloudSpeed1 = "0.0001";
         cloudSpeed2 = "0.0002";
         cloudSpeed3 = "0.0003";
         visibleDistance = "500";
         fogDistance = "300";
         fogColor = "0.6 0.6 0.6 1";
         fogStorm1 = "0";
         fogStorm2 = "0";
         fogStorm3 = "0";
         fogVolume1 = "-1 7.45949e-31 1.3684e-38";
         fogVolume2 = "-1 1.07208e-14 8.756e-14";
         fogVolume3 = "-1 5.1012e-10 2.05098e-08";
         fogVolumeColor1 = "128 128 128 0";
         fogVolumeColor2 = "128 128 128 4e-06";
         fogVolumeColor3 = "128 128 128 1.44355e+07";
         windVelocity = "1 0 0";
         windEffectPrecipitation = "0";
         SkySolidColor = "0.6 0.6 0.6 1";
         useSkyTextures = "1";
         renderBottomTexture = "1";
         noRenderBans = "1";
      };
      new MissionArea(MissionArea) {
         area = "-360 -648 720 1296";
         flightCeiling = "300";
         flightCeilingRange = "20";
            locked = "true";
      };
   };
   new SimGroup(HelpBubbleGroup) {

      new StaticShape(fanintroduction) {
         position = "78 -45.0732 41.5";
         rotation = "1 0 0 0";
         scale = "1 1 1";
         dataBlock = "HelpBubble";
            disable = "0";
            displayonce = "0";
            extended = "0";
            persistTime = "2000";
            text = "Don\'t let these Flower Fans blow you away!";
            triggerRadius = "4";
      };
      new StaticShape(twocannons) {
         position = "106 -82 63.5";
