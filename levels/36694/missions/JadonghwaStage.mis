addMaterialMapping("Sa_Jadonghwa_Mud", PQMudMaterial);
addMaterialMapping("Sa_Jadonghwa_Grass", PQGrassMaterial);
addMaterialMapping("Sa_Jadonghwa_Grass_Dark", PQGrassMaterial);
