// AMBIENT BEGIN
new AudioProfile(JadonghwaAmbientSfx) {
   fileName = "~/data/sa_assets/Jadonghwa/Sounds/jdh_ambient.wav";
   description = AudioLooping2D;
   preload = true;
};

function MissionStartup() {
	alxStop($JadonghwaAmbient);

	$JadonghwaAmbient = alxPlay(JadonghwaAmbientSfx);
	// hmm...
}

function clientCbOnMissionEnded() {
	alxStop($JadonghwaAmbient);
}

// AMBIENT END

// BEGINNING OF JADONGHWA COSMOS ASSETS (Only the Cosmos flower-related datablocks go here)

datablock StaticShapeData(JdhSap) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/JadonghwaSap.dts";
};

function JdhSap::onCollision(%this, %obj, %col) {
	%col.getDatablock().onOutOfBounds(%col);
}

new MaterialProperty(JdhSapMaterial) {
	friction = -0.7;
	restitution = 0.3;
	force = 7.3;
};

addMaterialMapping("jdh_sap" , JdhSapMaterial);

// No, these aren't the nest egg you wanna find.
datablock StaticShapeData(JdhEasterEgg) {
	className = "Scenery";
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/JdhEggShape.dts";
	skin[0] = "base";
	skin[1] = "chk1";
	skin[2] = "chk2";
	skin[3] = "chk3";
	skin[4] = "str1";
	skin[5] = "str2";
	skin[6] = "str3";
	skin[7] = "chkq1";
	skin[8] = "chkq3";

	customField[0, "field"  ] = "skin";
	customField[0, "type"   ] = "string";
	customField[0, "name"   ] = "Skin Name";
	customField[0, "desc"   ] = "Which skin to use (see skin selector).";
	customField[0, "default"] = "";
};

// The flower switch

datablock AudioProfile(FlowerBtnSfx) {
	filename    = "~/data/sa_assets/Jadonghwa/Sounds/jdh_sw.wav";
	description = AudioDefault3d;
	preload = true;
};

datablock StaticShapeData(FlowerBtn) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/FlowerBtn.dts";

	skin[0] = "base";
	skin[1] = "purple";
	skin[2] = "red";
	skin[3] = "blue";

	customField[0, "field"  ] = "skin";
	customField[0, "type"   ] = "string";
	customField[0, "name"   ] = "Skin Name";
	customField[0, "desc"   ] = "Which skin to use (see skin selector).";
	customField[0, "default"] = "";
	customField[1, "field"  ] = "TargetObject";
	customField[1, "type"   ] = "string";
	customField[1, "name"   ] = "Target Object Name";
	customField[1, "desc"   ] = "The object to start moving.";
	customField[1, "default"] = "";
	customField[2, "field"  ] = "TargetPath";
	customField[2, "type"   ] = "string";
	customField[2, "name"   ] = "Target Path Node Name";
	customField[2, "desc"   ] = "The starting pathnode.";
	customField[2, "default"] = "";

	customField[3, "field"  ] = "secondary";
	customField[3, "type"   ] = "boolean";
	customField[3, "name"   ] = "Use Secondary Path";
	customField[3, "desc"   ] = "Whether to use two paths instead of one.";
	customField[3, "default"] = "";
	customField[4, "field"  ] = "TargetObjectB";
	customField[4, "type"   ] = "string";
	customField[4, "name"   ] = "Secondary Target Object Name";
	customField[4, "desc"   ] = "The object to start moving.";
	customField[4, "default"] = "";
	customField[5, "field"  ] = "TargetPathB";
	customField[5, "type"   ] = "string";
	customField[5, "name"   ] = "Secondary Target Path Node Name";
	customField[5, "desc"   ] = "The starting pathnode.";
	customField[5, "default"] = "";
};

function FlowerBtn::onCollision(%this, %obj) {
	// Unlocks the mechanism
	if (%obj._active == 0) {
		%obj._active = 1;
		%obj.TargetObject.MoveOnPath(%obj.TargetPath);
		endtriggerhere.MoveOnPath(endtriggernodehere);

		if (%obj.secondary == 1) {
			%obj.TargetObjectB.MoveOnPath(%obj.TargetPathB);
			// Hmm...
			pinkbutton.MoveOnPath(%obj.TargetPathB);
		}

		%obj.playThread(0,"a");
		%obj.playAudio(0,FlowerBtnSfx);
	}
}

function FlowerBtn::onMissionReset(%this, %obj) {
	%obj.setSkinName(%obj.skin);

	%obj._active = 0;

	%obj.playThread(0,"a");
	%obj.stopThread(0);
}

// Time Travel Item
datablock ItemData(CosmosTimeTravelItem : TimeTravelItem) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";

	// Basic Item properties
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/CosmosTimer.dts";

	//For ::timeCheck() to replace if the time is negative
	replacement = "TimePenaltyItem_PQ";
};

function CosmosTimeTravelItem::onAdd(%this, %obj) {
	%obj.setSkinName(%obj.skin);
	%obj.playThread(0,"a");
	return TimeTravelItem::onAdd(%this, %obj);
}
function CosmosTimeTravelItem::onPickup(%this,%obj,%user,%amount) {
	return TimeTravelItem::onPickup(%this, %obj, %user, %amount);
}

