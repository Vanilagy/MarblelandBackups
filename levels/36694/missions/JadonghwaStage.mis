// Jadonghwa Cosmos Flower Bumpers

// sound profile here
datablock AudioProfile(CosmosBumperSfx) {
	filename    = "~/data/sa_assets/Jadonghwa/Sounds/jdh_bump.wav";
	description = AudioDefault3d;
	preload = true;
};

datablock StaticShapeData(CosmosBumper) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/CosmosBumper.dts";
	skin[0] = "base";
	skin[1] = "magenta";
	skin[2] = "pink";
	skin[3] = "white";

	customField[0, "field"  ] = "skin";
	customField[0, "type"   ] = "string";
	customField[0, "name"   ] = "Skin Name";
	customField[0, "desc"   ] = "Which skin to use (see skin selector).";
	customField[0, "default"] = "";
};
function CosmosBumper::onAdd(%this,%obj) {
	%obj.setSkinName(%obj.skin);
}
function CosmosBumper::onCollision(%this, %obj) {
	%obj.stopThread(0);
	// Same piece of code as bumpers.cs
	%obj.schedule(1, playThread, 0, "a");

	//The following should be uncommented once the sound effect audio_profile becomes available
	%obj.playAudio(0,CosmosBumperSfx);
}

//Material for the Jadonghwa cosmos bumper
new MaterialProperty(JadonghwaBumperMaterial) {
		friction = 0;
		restitution = 0;
		force = 13.0613;
};
addMaterialMapping("jdh_bumper" , JadonghwaBumperMaterial);

//The Jadonghwa Cosmos Fans
datablock AudioProfile(CosmosFanSfx) {
	filename    = "~/data/sa_assets/Jadonghwa/Sounds/jdh_fan.wav";
	description = AudioClosestLooping3d;
	preload = true;
};

datablock StaticShapeData(CosmosFan) {
	superCategory = "SummerArmy";
	category = "Jadonghwa";
	shapeFile = "~/data/sa_assets/Jadonghwa/Shapes/CosmosFan.dts";
	scopeAlways = true;

	forceType[0] = Cone;       // Force type {Spherical, Field, Cone}
	forceNode[0] = 0;          // Shape node transform
	forceStrength[0] = 40;     // Force to apply
	forceStrengthModifier[0] = 1; //Modifier of forceStrength
	forceRadius[0] = 10;       // Max radius
	forceArc[0] = 0.4;         // Cos angle

	powerOn = true;
	// Default state

	skin[0] = "base";
	skin[1] = "magenta";
	skin[2] = "pink";
	skin[3] = "white";

	customField[0, "field"  ] = "skin";
	customField[0, "type"   ] = "string";
	customField[0, "name"   ] = "Skin Name";
	customField[0, "desc"   ] = "Which skin to use (see skin selector).";
	customField[0, "default"] = "";
};


function CosmosFan::onAdd(%this,%obj) {
	%obj.setSkinName(%obj.skin);

	if (%this.powerOn) {
		%obj.playAudio(0, CosmosFanSfx);
		%obj.playThread(0,"a");
	}
	%obj.setPoweredState(%this.powerOn);
}

function CosmosFan::onTrigger(%this,%obj,%mesg) {
	if (%mesg) {
		%obj.playAudio(0, CosmosFanSfx);
		%obj.playThread(0,"a");
	} else {
		%obj.stopThread(0);
		%obj.stopAudio(0);
	}
	%obj.setPoweredState(%mesg);
}

function CosmosFan::onMissionReset(%this, %obj) {
	if (!$Game::Menu && %obj.getPoweredState()) {
		%obj.stopAudio(0);
		%obj.playAudio(0, CosmosFanSfx);
	}
}

