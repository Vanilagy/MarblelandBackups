datablock StaticShapeData(SunPlane) {
	className = "SunPlane";
	superCategory = "Mushroom Gorge";
	shapeFile = "~/data/shapes/Mushroom Gorge/sun.dts";
};
function syncObjectRotationWithCamera(%shapeId)
{
    if (!isObject(%shapeId))
        return;

    %client = LocalClientConnection;
    if (isObject(%client))
    {
        %controlObj = %client.getControlObject();
        
        if (isObject(%controlObj))
        {
            %shapePos = %shapeId.getPosition();
            %targetPos = "";

            if (%controlObj.getClassName() $= "Marble")
            {
                %targetPos = %controlObj.getPosition();
            }
            else
            {
                %targetPos = getWords(%controlObj.getTransform(), 0, 2);
            }

            if (%targetPos !$= "")
            {
                %dirX = getWord(%targetPos, 0) - getWord(%shapePos, 0);
                %dirY = getWord(%targetPos, 1) - getWord(%shapePos, 1);
                %dirZ = getWord(%targetPos, 2) - getWord(%shapePos, 2);

                if (%dirX == 0 && %dirY == 0)
                    %dirY = 0.1;

                // --- CÁLCULO HORIZONTAL (Yaw) ---
                %yaw = mAtan(%dirX, %dirY);

                // --- CÁLCULO VERTICAL (Pitch) ---
                %dist2D = mSqrt((%dirX * %dirX) + (%dirY * %dirY));
                %pitch = mAtan(%dirZ, %dist2D);

                // CORRECCIÓN MATEMÁTICA DE AMBOS EJES (Horizontal y Vertical)
                if (%controlObj.getClassName() $= "Marble")
                {
                    // Eje horizontal (Ya corregido anteriormente)
                    %yaw = (-%yaw) + 3.14159265; 
                    
                    // CORRECCIÓN: Invertimos el signo del Pitch para arreglar el eje vertical
                    %pitch = -%pitch; 
                }
                else
                {
                    // Ajuste para el modo cámara libre
                    %yaw = -%yaw;
                    %pitch = %pitch; // Invertido simétricamente también en modo libre si fallaba
                }

                // Creamos la matriz combinada (Pitch, Roll, Yaw)
                %eulerRot = %pitch SPC "0" SPC %yaw;
                %matrix = MatrixCreateFromEuler(%eulerRot);
                %finalRot = getWords(%matrix, 3, 6);

                %shapeId.setTransform(%shapePos SPC %finalRot);
            }
        }
    }

    %shapeId.cameraSyncSchedule = schedule(32, %shapeId, "syncObjectRotationWithCamera", %shapeId);
}

function SunPlane::onAdd(%this, %obj)
{
    syncObjectRotationWithCamera(%obj);
}

function TuStaticShapeData::onRemove(%this, %obj)
{
    // Limpieza para evitar fugas de memoria al destruir el objeto
    cancel(%obj.cameraSyncSchedule);
}
