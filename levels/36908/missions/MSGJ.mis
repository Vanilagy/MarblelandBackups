datablock AudioDescription(AudioCustomCollision3d) {
   volume   = 1.0;
   isLooping = false; 
   is3D      = true;
   ReferenceDistance = 10.0;
   MaxDistance       = 50.0;
   type      = 4; 
};
datablock AudioProfile(BOING) {
	filename    = "~/data/shapes/Mushroom Gorge/BoingSFX.wav";
	description = AudioCustomCollision3d;
	preload = true;
};
datablock AudioProfile(BOINGCAVE) {
	filename    = "~/data/shapes/Mushroom Gorge/BoingCaveSFX.wav";
	description = AudioCustomCollision3d;
	preload = true;
};
