datablock StaticShapeData(Red) {
	className = "Red";
	superCategory = "Mushroom Gorge";
	shapeFile = "~/data/shapes/Mushroom Gorge/mushroom red with colisions.dts";
};
function Red::onAdd(%this, %obj){
	%obj.playThread(0, "Red");
}
function Red::onCollision(%this, %obj, %col) {
	%obj.playAudio(0, BOING);
}
function Red::onCollision(%this, %obj, %col, %vec, %speed) {
   // %this = El datablock del StaticShape
   // %obj  = El StaticShape clonado en el mapa
   // %col  = La bola que impacta

   if (%col.getClassName() $= "Marble" || %col.getClassName() $= "Player") {
      
      // 1. Validar que la bola no tenga un bloqueo de sonido activo para ESTE objeto específico
      if (%col.bouncySoundBlock[%obj]) {
         return; 
      }

      // 2. Obtener la velocidad lineal actual de la bola
      %velocity = %col.getVelocity();
      %velLen = VectorLen(%velocity);

      // 3. Umbral de velocidad mínimo para evitar que suene si la bola está en reposo relativo
      if (%velLen > 1.5) {
         
         // Activamos el bloqueo inmediatamente
         %col.bouncySoundBlock[%obj] = true;

         // Reproducir sonido posicionalmente
         serverPlay3D(BOING, %obj.getTransform());

         // 4. Ejecutar el bucle de verificación de salida de rango
         %this.checkBallDeparture(%obj, %col);
      }
   }
}

function Red::checkBallDeparture(%this, %obj, %col) {
   // Si la bola o el objeto dejaron de existir en la partida, abortar
   if (!isObject(%obj) || !isObject(%col)) {
      return;
   }

   // Calcular la distancia física real entre los centros de ambos objetos
   %dist = VectorDist(%obj.getPosition(), %col.getPosition());

   // OBTENER EL RADIO DE SEGURIDAD:
   // Si el objeto mide por ejemplo 3 unidades de radio, sumamos 2 unidades de margen por la animación
   // Ajusta el "5.0" dependiendo del tamaño real de tu StaticShape en el juego
   %radioDeSeguridad = 5.0; 

   if (%dist > %radioDeSeguridad) {
      // Si la bola ya superó la distancia de la colisión animada, liberamos el bloqueo por completo
      %col.bouncySoundBlock[%obj] = false;
   } else {
      // Si sigue demasiado cerca, reevaluar en 100 milisegundos sin reproducir ruidos
      %this.schedule(100, "checkBallDeparture", %obj, %col);
   }
}


// Función auxiliar para desbloquear la colisión con ese objeto específico
function Marble::resetHitLock(%this, %obj) {
   %this.hasHitObject[%obj] = false;
}

function Red::resetSoundCooldown(%this) {
   %this.soundCooldown = false;
}
