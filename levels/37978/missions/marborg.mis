// Original level by Whirligig231, ported to PQ by abhi.

$mbPi            = 3.1415926535898;
$mbMissileRadius = 1.5;
$mbKick          = 10;
$mbMineRadius    = 0.35;
$mbMaxFrame      = 100;    
$mbMissileLife   = 20000;  

datablock AudioProfile(MarborgStepSfx) {
   filename    = "~/data/sound/step.wav";
   description = AudioDefault3d;
   preload = true;
};
datablock AudioProfile(MarborgLoadSfx) {
   filename    = "~/data/sound/load.wav";
   description = AudioDefault3d;
   preload = true;
};
datablock AudioProfile(MarborgFireSfx) {
   filename    = "~/data/sound/fire.wav";
   description = AudioDefault3d;
   preload = true;
};
datablock AudioProfile(MarborgHopSfx) {
   filename    = "~/data/sound/hop.wav";
   description = AudioDefault3d;
   preload = true;
};
datablock AudioProfile(MarborgExplodeSfx) {
   filename    = "~/data/sound/explode.wav";
   description = AudioDefault3d;
   preload = true;
};

datablock AudioProfile(MissileFlyingSfx)
{
   filename    = "~/data/sound/missile.wav";
   description = AudioClosestLooping3d;
   preload = true;
};

// DATABLOCKS

datablock StaticShapeData(MarborgSpawner) {
   className = "MarborgSpawn";
   category = "Epic Robot Boss Battles";
   shapeFile = "~/data/shapes/balls/ball-superball.dts";
   scopeAlways = true;
};

datablock StaticShapeData(Marborg) {
   className = "MarborgParts";
   shapeFile = "~/data/shapes/marbong/robot_body.dts";
   scopeAlways = true;
};

datablock StaticShapeData(MarborgLegLeft) {
   className = "MarborgParts";
   shapeFile = "~/data/shapes/marbong/robot_leg_left.dts";
   scopeAlways = true;
};

datablock StaticShapeData(MarborgLegRight) {
   className = "MarborgParts";
   shapeFile = "~/data/shapes/marbong/robot_leg_right.dts";
   scopeAlways = true;
};

datablock StaticShapeData(MarborgArmLeft) {
   className = "MarborgParts";
   shapeFile = "~/data/shapes/marbong/robot_arm_left.dts";
   scopeAlways = true;
};

datablock StaticShapeData(MarborgArmRight) {
   className = "MarborgParts";
   shapeFile = "~/data/shapes/marbong/robot_arm_right.dts";
   scopeAlways = true;
};

datablock StaticShapeData(MarborgHead) {
   className = "MarborgParts";
   shapeFile = "~/data/shapes/marbong/robot_head.dts";
   scopeAlways = true;
};

datablock StaticShapeData(MarborgMissile) {
   className = "Explosive";
   category = "Hazards";
   shapeFile = "~/data/shapes/marbong/missile.dts";
   renderWhenDestroyed = false;
   isBullet = true;
};

datablock StaticShapeData(LandMineSpecial)
{
   className = "Explosive";
   category = "Hazards";
   shapeFile = "~/data/shapes/hazards/landmine.dts";
   renderWhenDestroyed = false;
};

datablock fxLightData(MarborgBlastLight)
{
   LightOn              = true;
   Radius               = 2;
   Brightness           = 6;
   Colour               = "0.2 0.2 0.2 0.2";
};

// true if the string contains NaN/Inf/IND text or absurdly large numbers
function mbBad(%s)
{
   %l = strlwr(%s);
   // "nan", "inf", "-1.#IND", "1.#QNAN"
   if (strpos(%l, "nan") != -1 || strpos(%l, "inf") != -1 || strpos(%l, "ind") != -1)
      return true;
   %c = getWordCount(%l);
   for (%i = 0; %i < %c; %i++)
   {
      if (mAbs(getWord(%l, %i)) > 100000)
         return true;
   }
   return false;
}

// normalize, but never divide by ~0
function mbNorm(%v, %fallback)
{
   %l = VectorLen(%v);
   if (%l < 0.000001)
      return %fallback;
   return VectorScale(%v, 1 / %l);
}


function mbMin(%x, %y) { return (%x < %y) ? %x : %y; }
function mbMax(%x, %y) { return (%x > %y) ? %x : %y; }

function mbAngDiff(%x, %y)
{
   %diff = %x - %y;
   %twoPi = 2 * $mbPi;
   %diff = %diff - %twoPi * mFloor((%diff + $mbPi) / %twoPi);
   return %diff;
}

function mbVecAngle(%u, %v)
{
   %lu = VectorLen(%u);
   %lv = VectorLen(%v);
   if (%lu < 0.000001 || %lv < 0.000001)
      return 0;
   %c = VectorDot(%u, %v) / %lu / %lv;
   if (%c > 1) %c = 1;
   if (%c < -1) %c = -1;
   return mAcos(%c);
}

function mbCrossSpecial(%u, %v)
{
   %c = VectorCross(%u, %v);
   // parallel (angle 0) or anti-parallel (angle pi): cross product is ~zero
   if (VectorLen(%c) < 0.000001)
   {
      if (VectorDot(%u, %v) < 0)
      {
         if (mAbs(getWord(%u, 0)) < 0.01 && mAbs(getWord(%u, 1)) < 0.01)
            return VectorCross(%u, "1 0 0");
         return VectorCross(%u, "0 0 1");
      }
      return "0 0 1"; // angle is 0, axis is irrelevant
   }
   return %c;
}

function mbAxis(%u, %v) { return mbNorm(mbCrossSpecial(%u, %v), "0 0 1"); }
function mbVecRot(%u, %v) { return mbAxis(%u, %v) SPC -mbVecAngle(%u, %v); }

function mbVecRej(%u, %v)
{
   %d = VectorDot(%v, %v);
   if (%d < 0.000001)
      return %u;
   return VectorSub(%u, VectorScale(%v, VectorDot(%u, %v) / %d));
}

function mbYaw(%v) { return mAtan(getWord(%v, 1), getWord(%v, 0)); }
function mbPitch(%v) { return mAtan(getWord(%v, 2), mSqrt(mPow(getWord(%v, 0), 2) + mPow(getWord(%v, 1), 2))); }

function mbRight(%mat)   { return MatrixMulVector(%mat, "1 0 0"); }
function mbForward(%mat) { return MatrixMulVector(%mat, "0 1 0"); }
function mbUp(%mat)      { return MatrixMulVector(%mat, "0 0 1"); }

function mbMatInverse(%mat)
{
   %pos = getWords(%mat, 0, 2);
   %rot = getWords(%mat, 3, 6);
   return MatrixMultiply("0 0 0" SPC (getWords(%rot, 0, 2) SPC -getWord(%rot, 3)), VectorScale(%pos, -1) SPC "1 0 0 0");
}

function mbMatDivide(%m1, %m2) { return MatrixMultiply(%m1, mbMatInverse(%m2)); }
function mbRotMul(%r1, %r2) { return getWords(MatrixMultiply("0 0 0" SPC %r1, "0 0 0" SPC %r2), 3); }
function mbRotMulVec(%rot, %vec) { return MatrixMulVector("0 0 0" SPC %rot, %vec); }

function mbRotInterp(%rot1, %rot2, %t)
{
   %mat1 = "0 0 0" SPC %rot1;
   %mat2 = "0 0 0" SPC %rot2;
   %matSub = mbMatDivide(%mat2, %mat1);
   %newMat = MatrixMultiply("0 0 0" SPC getWords(%matSub, 3, 5) SPC (%t * getWord(%matSub, 6)), %mat1);
   return getWords(%newMat, 3);
}

function mbRotPoint(%rot, %dir, %vec)
{
   if (%vec $= "") %vec = "0 0 1";
   return mbRotMul(mbVecRot(mbRotMulVec(%rot, %vec), %dir), %rot);
}

function mbPos(%obj) { return getWords(%obj.getTransform(), 0, 2); }

function mbPlayer()
{
   if (isObject(ClientGroup) && ClientGroup.getCount() > 0)
      return ClientGroup.getObject(0).player;
   return 0;
}

function mbPlayerPos()
{
   %p = mbPlayer();
   if (!isObject(%p)) return "";
   %pos = getWords(%p.getTransform(), 0, 2);
   if (mbBad(%pos)) return "";
   return %pos;
}

function mbInitText()
{
   $mbTaunt[0] = "YOU DIE SOON!";
   $mbTaunt[1] = "WHY YOU NOT DEAD YET?";
   $mbTaunt[2] = "YOU CAN NOT HIDE FOREVER!";
   $mbTaunt[3] = "I GRIND YOUR BONES TO MAKE ... NEVER MIND";
   $mbTaunt[4] = "YOU ARE SMALL LIKE KITTEN";
   $mbTaunt[5] = "YOU MORE WEAK THAN MY GRAMMAR!";
   $mbTaunt[6] = "YOU CAN NOT RUN FROM ME!";
   $mbTaunt[7] = "I WILL RULE THIS SMALL PLATFORM";
   $mbHit[0] = "OUCH!";
   $mbHit[1] = "AARGHH! MY SPLEEN!";
   $mbHit[2] = "WAHHHHH! YOU JERK!";
   $mbHit[3] = "WHAT ARE DOING?!";
   $mbHit[4] = "THIS HURTS ME!";
   $mbHit[5] = "NOOOO!";
   $mbHit[6] = "OUCHY! YOU HURT!";
   $mbHit[7] = "I BREAK BONE! OWWW!";
}

function mbSay(%kind)
{
   if (%kind $= "taunt") %msg = $mbTaunt[getRandom(7)];
   else if (%kind $= "hit") %msg = $mbHit[getRandom(7)];
   else %msg = "HOW ARE YOU MORE POWERFUL THAN ME????";
   addHelpLine(%msg);
}

function mbMakePart(%db, %pos)
{
   %o = new StaticShape() {
      position = %pos;
      rotation = "1 0 0 0";
      scale = "1 1 1";
      dataBlock = %db;
   };
   MissionGroup.add(%o);
   return %o;
}

function mbBossInit(%obj)
{
   $Marborg = %obj;
   %obj.startFade(0, 0, false);
   %p = mbPos(%obj);

   %obj.legLeft  = mbMakePart("MarborgLegLeft",  VectorAdd(%p, "0 0 1.5"));
   %obj.legRight = mbMakePart("MarborgLegRight", VectorAdd(%p, "0 0 1.5"));
   %obj.armLeft  = mbMakePart("MarborgArmLeft",  VectorAdd(%p, "0 0 3.3"));
   %obj.armRight = mbMakePart("MarborgArmRight", VectorAdd(%p, "0 0 3.3"));
   %obj.head     = mbMakePart("MarborgHead",     %p);

   if (isObject(%obj.legLeft))  %obj.legLeft.startFade(0, 0, false);
   if (isObject(%obj.legRight)) %obj.legRight.startFade(0, 0, false);
   if (isObject(%obj.armLeft))  %obj.armLeft.startFade(0, 0, false);
   if (isObject(%obj.armRight)) %obj.armRight.startFade(0, 0, false);
   if (isObject(%obj.head))     %obj.head.startFade(0, 0, false);

   %obj.home = %p;
   %obj.origZ = getWord(%p, 2);
   %obj.mode = "Wait 5";
   %obj.timer = 0;
   %obj.hitTimer = 0;
   %obj.hits = 0;
   %obj.rockets = 0;
   %obj.flash = 0;
}

function mbSpawnBoss()
{
   mbClearBoss();
   removeStaticMarborgs(MissionGroup);
   if (!isObject($mbSpawner)) return;
   %boss = new StaticShape() {
      position = mbPos($mbSpawner);
      rotation = "1 0 0 0";
      scale = "1 1 1";
      dataBlock = "Marborg";
   };
   MissionGroup.add(%boss);
   mbBossInit(%boss);
}

function mbDeleteBossParts(%obj)
{
   if (isObject(%obj.legLeft))  %obj.legLeft.delete();
   if (isObject(%obj.legRight)) %obj.legRight.delete();
   if (isObject(%obj.armLeft))  %obj.armLeft.delete();
   if (isObject(%obj.armRight)) %obj.armRight.delete();
   if (isObject(%obj.head))     %obj.head.delete();
}

function mbClearBoss()
{
   // no hiccups
   if ($mbEndPadSched !$= "")
   {
      cancel($mbEndPadSched);
      $mbEndPadSched = "";
   }

   if (isObject($Marborg))
   {
      mbDeleteBossParts($Marborg);
      $Marborg.delete();
   }
   $Marborg = "";
   if (isObject(MBMissileGroup))
   {
      while (MBMissileGroup.getCount() > 0)
         MBMissileGroup.getObject(0).delete();
   }
   if (isObject($mbEndPad))
      $mbEndPad.delete();
   $mbEndPad = "";
}

function mbBossHide(%obj, %f)
{
   if (%obj.flash == %f) return;
   %obj.flash = %f;

   if (isObject(%obj))          %obj.startFade(0, 0, %f);
   if (isObject(%obj.legLeft))  %obj.legLeft.startFade(0, 0, %f);
   if (isObject(%obj.legRight)) %obj.legRight.startFade(0, 0, %f);
   if (isObject(%obj.armLeft))  %obj.armLeft.startFade(0, 0, %f);
   if (isObject(%obj.armRight)) %obj.armRight.startFade(0, 0, %f);
   if (isObject(%obj.head))     %obj.head.startFade(0, 0, %f);
}

function mbFinishLevel()
{
   $mbEndPadSched = "";
   setGameState("end");
}

function mbBossHit(%obj)
{
   if (%obj.hitTimer > 0) return;
   if (%obj.mode $= "Explode") return;   // already dying;
   mbSay("hit");
   serverPlay2d(MarborgExplodeSfx);
   %obj.hits++;
   %obj.hitTimer = 2000;
   if (%obj.mode !$= "Fire")
      %obj.rockets = mFloor(%obj.hits / 2);
   if (%obj.hits == 2 && isObject(%obj.legRight))
      %obj.legRight.setScale("0 0 0");
   else if (%obj.hits == 4 && isObject(%obj.legLeft))
      %obj.legLeft.setScale("0 0 0");
   else if (%obj.hits >= 7)
   {
      %obj.mode = "Explode";
      %obj.timer = 0;
      %obj.stage = 0;
      // no stray missiles hitting you while he falls apart
      if (isObject(MBMissileGroup))
      {
         while (MBMissileGroup.getCount() > 0)
            MBMissileGroup.getObject(0).delete();
      }
   }
}

function mbFire(%obj)
{
   if (!isObject(%obj.armLeft) || !isObject(%obj.armRight)) return;
   if (!isObject(MBMissileGroup)) return;
   %misrot = mbRotMul(getWords(%obj.armLeft.getTransform(), 3), "-1 0 0 1.5708");
   %deg = getWord(%misrot, 3) * 180 / $mbPi;
   %axis = getWords(%misrot, 0, 2);

   %m1 = new StaticShape() {
      position = VectorAdd(mbPos(%obj.armLeft), MatrixMulVector(%obj.armLeft.getTransform(), "1.35 0 -1.7"));
      rotation = %axis SPC %deg;
      scale = "1 1 1";
      dataBlock = "MarborgMissile";
   };
   mbMissileInit(%m1);

   %m2 = new StaticShape() {
      position = VectorAdd(mbPos(%obj.armRight), MatrixMulVector(%obj.armRight.getTransform(), "-1.35 0 -1.7"));
      rotation = %axis SPC %deg;
      scale = "1 1 1";
      dataBlock = "MarborgMissile";
   };
   mbMissileInit(%m2);
}

function mbBossStep(%obj, %time, %pp)
{
   %obj.hitTimer -= %time;
   %time *= 0.85 + 0.25 * %obj.hits;
   %obj.timer += %time;
   if (%obj.hits == 4)
   {
      %t = %obj.hitTimer - 5000;
      %obj.home = getWords(%obj.home, 0, 1) SPC %obj.origZ - mbMin(1, %t * %t / 250000);
   }

   %f = (%obj.hitTimer > 0) ? ((%obj.hitTimer % 200) < 100) : 0;
   mbBossHide(%obj, %f);

   if (%obj.mode $= "Wait 5")
   {
      if (%obj.timer >= 5000) { %obj.timer = 0; %obj.mode = "Run"; }
   }
   else if (%obj.mode $= "Run" || %obj.mode $= "Turn")
   {
      if (%obj.mode $= "Run")
      {
         %targ = VectorSub(VectorScale(%obj.home, 2), %pp);
         %targDir = mbYaw(VectorSub(%targ, mbPos(%obj)));
      }
      else
      {
         %targ = mbPos(%obj);
         %targDir = mbYaw(VectorSub(%pp, mbPos(%obj)));
      }
      %dir = $mbPi + mbYaw(mbForward(%obj.getTransform()));
      %ang = mbAngDiff(%targDir, %dir);
      %capAng = mbMax(-0.03, mbMin(%ang, 0.03));

      if (%obj.mode $= "Run")
      {
         %moveVec = MatrixMulVector("0 0 0 0 0 -1" SPC ($mbPi + %dir + %capAng), VectorScale("-3 0 0", %time / 1000));
         %obj.setTransform(VectorAdd(%moveVec, getWords(%obj.getTransform(), 0, 2)) SPC getWords(%obj.getTransform(), 3));
      }

      %sinPer = (%obj.hits > 1) ? 600 : 300;
      %sine = mSin(%obj.timer * $mbPi / %sinPer);
      %z = getWord(%obj.home, 2) + mAbs(%sine);

      %obj.setTransform(getWords(%obj.getTransform(), 0, 1) SPC %z SPC mbRotMul("0 0 1" SPC -%capAng, getWords(%obj.getTransform(), 3)));
      if (isObject(%obj.legLeft))  %obj.legLeft.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 1.5) SPC mbRotMul("0 0 1" SPC -%capAng, getWords(%obj.getTransform(), 3)));
      if (isObject(%obj.legRight)) %obj.legRight.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 1.5) SPC mbRotMul("0 0 1" SPC -%capAng, getWords(%obj.getTransform(), 3)));
      if (isObject(%obj.armLeft))  %obj.armLeft.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 3.3) SPC mbRotMul("0 0 1" SPC -%capAng, getWords(%obj.getTransform(), 3)));
      if (isObject(%obj.armRight)) %obj.armRight.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 3.3) SPC mbRotMul("0 0 1" SPC -%capAng, getWords(%obj.getTransform(), 3)));
      if (isObject(%obj.head))     %obj.head.setTransform(getWords(%obj.getTransform(), 0, 1) SPC %z SPC mbRotMul("0 0 1" SPC -%capAng, getWords(%obj.getTransform(), 3)));

      %rot = (%obj.hits > 1) ? -mSin(%obj.timer * 2 * $mbPi / %sinPer) * $mbPi / 6 : %sine * $mbPi / 6;
      if (isObject(%obj.legLeft))  %obj.legLeft.setTransform(getWords(%obj.legLeft.getTransform(), 0, 2) SPC mbRotMul(getWords(%obj.getTransform(), 3), "1 0 0" SPC %rot));
      if (isObject(%obj.legRight)) %obj.legRight.setTransform(getWords(%obj.legRight.getTransform(), 0, 2) SPC mbRotMul(getWords(%obj.getTransform(), 3), "-1 0 0" SPC -%rot));

      if (%sine * mSin((%obj.timer - %time) * $mbPi / %sinPer) < 0)
      {
         if (%obj.hits < 4) serverPlay2d(MarborgStepSfx); else serverPlay2d(MarborgHopSfx);
         if (%obj.mode $= "Run" && VectorDist(mbPos(%obj), %targ) < 2)
            %obj.mode = "Turn";
         else if (%obj.mode $= "Turn" && mAbs(%ang) < 0.03)
         {
            %obj.mode = "Prepare";
            %obj.timer = 0;
            serverPlay2d(MarborgLoadSfx);
         }
      }
   }
   else if (%obj.mode $= "Prepare")
   {
      %z = getWord(%obj.home, 2);
      %obj.setTransform(getWords(%obj.getTransform(), 0, 1) SPC %z SPC getWords(%obj.getTransform(), 3));

      if (isObject(%obj.armLeft))
      {
         %rot = mbPitch(mbUp(%obj.armLeft.getTransform()));
         %targRot = -mbPitch(mbVecRej(VectorSub(%pp, mbPos(%obj.armLeft)), mbRight(%obj.armLeft.getTransform())));
         %ang = mbAngDiff(%targRot, %rot);
         %capAng = mbMax(-0.03, mbMin(%ang, 0.03));
         %newrot = -(%rot + %capAng - $mbPi / 2);

         %obj.armLeft.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 3.3) SPC mbRotMul(getWords(%obj.getTransform(), 3), "1 0 0" SPC %newrot));
         if (isObject(%obj.armRight))
            %obj.armRight.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 3.3) SPC mbRotMul(getWords(%obj.getTransform(), 3), "1 0 0" SPC %newrot));

         if (%obj.timer > 1500)
         {
            %obj.mode = "Fire";
            %obj.timer = 0;
            %obj.tempPos = mbPos(%obj);
            %obj.tempR = %newrot;
            mbFire(%obj);
            serverPlay2d(MarborgFireSfx);
         }
      }
   }
   else if (%obj.mode $= "Fire")
   {
      %sine = 0.5 * mSin(%obj.timer * $mbPi / 1000);
      %legRot = isObject(%obj.legLeft) ? getWords(%obj.legLeft.getTransform(), 3) : "1 0 0 0";
      %newPos = VectorAdd(VectorAdd(%obj.tempPos, "0 0 1.5"), MatrixMulVector("0 0 0" SPC mbRotMul(%legRot, "1 0 0" SPC %sine), "0 0 -1.5"));
      %newArmPos = VectorAdd(VectorAdd(%obj.tempPos, "0 0 1.5"), MatrixMulVector("0 0 0" SPC mbRotMul(%legRot, "1 0 0" SPC %sine), "0 0 1.8"));

      %obj.setTransform(%newPos SPC mbRotMul(%legRot, "1 0 0" SPC %sine));
      if (isObject(%obj.head))     %obj.head.setTransform(%newPos SPC mbRotMul(%legRot, "1 0 0" SPC %sine));
      if (isObject(%obj.armLeft))  %obj.armLeft.setTransform(%newArmPos SPC mbRotMul(%legRot, "1 0 0" SPC (%sine + %obj.tempR)));
      if (isObject(%obj.armRight)) %obj.armRight.setTransform(%newArmPos SPC mbRotMul(%legRot, "1 0 0" SPC (%sine + %obj.tempR)));

      if (%obj.timer > 1000)
      {
         if (%obj.rockets == 0)
         {
            %obj.mode = "Reset";
            %obj.rockets = mFloor(%obj.hits / 2);
         }
         else
         {
            %obj.mode = "Fire";
            mbFire(%obj);
            serverPlay2d(MarborgFireSfx);
            %obj.rockets--;
         }
         %obj.timer = 0;
      }
   }
   else if (%obj.mode $= "Reset")
   {
      %z = getWord(%obj.home, 2);
      %legRot = isObject(%obj.legLeft) ? getWords(%obj.legLeft.getTransform(), 3) : "1 0 0 0";
      %obj.setTransform(getWords(%obj.getTransform(), 0, 1) SPC %z SPC %legRot);
      if (isObject(%obj.head)) %obj.head.setTransform(getWords(%obj.getTransform(), 0, 1) SPC %z SPC %legRot);

      %newrot = %obj.tempR * (1 - %obj.timer / 1000);
      if (isObject(%obj.armLeft))  %obj.armLeft.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 3.3) SPC mbRotMul(getWords(%obj.getTransform(), 3), "1 0 0" SPC %newrot));
      if (isObject(%obj.armRight)) %obj.armRight.setTransform(getWords(%obj.getTransform(), 0, 1) SPC (%z + 3.3) SPC mbRotMul(getWords(%obj.getTransform(), 3), "1 0 0" SPC %newrot));

      if (%obj.timer > 1000)
      {
         mbSay("taunt");
         %obj.mode = "Run";
         %obj.timer = 0;
      }
   }
   else if (%obj.mode $= "Explode")
   {
      // Falls apart in stages: legs first, then arms, then the top (head + body).
      if (%obj.stage < 1)
      {
         if (isObject(%obj.legLeft))  %obj.legLeft.delete();
         if (isObject(%obj.legRight)) %obj.legRight.delete();
         %obj.stage = 1;
         serverPlay2d(MarborgExplodeSfx);
      }
      if (%obj.stage < 2 && %obj.timer > 1800)
      {
         if (isObject(%obj.armLeft))  %obj.armLeft.delete();
         if (isObject(%obj.armRight)) %obj.armRight.delete();
         %obj.stage = 2;
         serverPlay2d(MarborgExplodeSfx);
      }
      if (%obj.stage < 3 && %obj.timer > 3600)
      {
         serverPlay2d(MarborgExplodeSfx);
         mbDeleteBossParts(%obj);   // head (and anything left)
         %obj.delete();             // body, the last piece
         $Marborg = "";
         mbSay("victory");
         if ($mbEndPadSched !$= "") cancel($mbEndPadSched);
         $mbEndPadSched = schedule(1500, 0, "mbFinishLevel");
      }
   }
}

function mbMissileInit(%m)
{
   if (!isObject(%m)) return;
   if (!isObject(MBMissileGroup))
   {
      %m.delete();
      return;
   }
   MBMissileGroup.add(%m);
   %m.timer = 0;
   %m.hit = 0;
   %m.playAudio(0, MissileFlyingSfx);
}

function mbMissileExplode(%obj, %why)
{
   if (%obj.hit) return;
   %obj.hit = 1;
   %obj.setDamageState("Destroyed");
   %obj.startFade(0, 0, true);
   %obj.stopAudio(0);
   %obj.schedule(100, "delete");
}

function mbMissileRay(%obj, %a, %b)
{
   %r = ContainerRayCast(%a, %b, $TypeMasks::StaticShapeObjectType | $TypeMasks::InteriorObjectType, %obj);
   %o = getWord(%r, 0);
   if (!isObject(%o)) return 0;
   if (%o.getClassName() $= "StaticShape")
   {
      %cn = %o.getDataBlock().className;
      if (%cn $= "MarborgParts" || %cn $= "MarborgSpawn") return 0;
   }
   return 1;
}

function mbFlash(%target)
{
   if (!isObject(%target)) return;
   %pos = mbPos(%target);
   if (mbBad(%pos)) return;
   %l = new fxLight() {
      position = %pos;
      rotation = "1 0 0 0";
      scale = "1 1 1";
      dataBlock = "MarborgBlastLight";
      Enable = "1";
      IconSize = "1";
   };
   if (!isObject(%l)) return;
   if (isObject(MBMissileGroup)) MBMissileGroup.add(%l);
   else MissionGroup.add(%l);
   %l.setParent(%target, "", false, "0 0 2", true);
   %l.schedule(250, "delete");
}

function mbKick(%from, %pp)
{
   if ($mbKick <= 0) return;
   %pl = mbPlayer();
   if (!isObject(%pl)) return;
   %dir = mbNorm(VectorSub(%pp, %from), "0 0 1");
   %pl.setVelocity(VectorAdd(%pl.getVelocity(), VectorScale(%dir, $mbKick)));
}

function mbMissileStep(%obj, %time, %pp)
{
   if (%obj.hit) return;
   %obj.timer += %time;

   // self-destruct so stray missiles never pile up
   if (%obj.timer > $mbMissileLife)
   {
      mbMissileExplode(%obj, "timeout");
      return;
   }

   %oldpos = mbPos(%obj);
   %oldrot = getWords(%obj.getTransform(), 3);
   if (mbBad(%oldpos SPC %oldrot))
   {
      mbMissileExplode(%obj, "bad transform: " @ %oldpos SPC %oldrot);
      return;
   }

   %dir = mbNorm(VectorSub(%pp, %oldpos), "0 1 0");
   %cur = mbRotMulVec(%oldrot, "0 -1 0");

   // Steering. When the missile already points (almost) at the player the turn
   // is ~zero and the engine's rotation conversion returns NaN (this is what
   // killed missiles when you were far away). So: only steer when there is a
   // real angle to turn, and if the result is still bad, keep the old heading.
   %midrot = %oldrot;
   if (mbVecAngle(%cur, %dir) > 0.002)
   {
      %newrot = mbRotPoint(%oldrot, %dir, "0 -1 0");
      %try = mbRotInterp(%oldrot, %newrot, %time / 100);
      if (!mbBad(%try))
         %midrot = %try;
   }
   %newpos = VectorAdd(%oldpos, VectorScale(mbForward("0 0 0" SPC %midrot), -%time / 150));
   %finalrot = mbRotMul(%midrot, "0 1 0 0.1");

   if (mbBad(%newpos SPC %finalrot))
   {
      mbMissileExplode(%obj, "bad new transform: " @ %newpos SPC %finalrot);
      return;
   }

   %obj.setTransform(%newpos SPC %finalrot);

   if ($mbMissileRadius > 0 && VectorDist(%newpos, %pp) < $mbMissileRadius)
   {
      mbKick(%newpos, %pp);
      serverPlay2d(MarborgExplodeSfx);
      mbFlash(mbPlayer());
      mbMissileExplode(%obj, "reached player");
      return;
   }

   if (mbMissileRay(%obj, %oldpos, VectorSub(VectorScale(%newpos, 2), %oldpos)))
   {
      mbMissileExplode(%obj, "ray hit");
      return;
   }

   if (isObject($Marborg))
   {
      %r = VectorDist(getWords(%newpos, 0, 1) SPC "0", getWords(mbPos($Marborg), 0, 1) SPC "0");
      if (%r < 2 && %obj.timer > 1500)
      {
         mbMissileExplode(%obj, "hit Marborg");
         mbBossHit($Marborg);
         mbFlash($Marborg);
      }
   }
}

function LandMineSpecial::onCollision(%this, %obj, %col)
{
   %obj.setDamageState("Destroyed");
   %obj.hit = 1;
   %obj.startFade(0, 0, true);
}

function mbMineExplode(%mine)
{
   %mine.setDamageState("Destroyed");
   %mine.hit = 1;
   %mine.startFade(0, 0, true);
}

function mbMineReset(%mine)
{
   %mine.setDamageState("Enabled");
   %mine.startFade(1000, 0, false);
   %mine.hit = 0;
}

function mbMineStep(%mine, %pp)
{
   if (%mine.hit) return;
   %mp = mbPos(%mine);
   if (isObject($Marborg))
   {
      %r = VectorDist(getWords(%mp, 0, 1) SPC "0", getWords(mbPos($Marborg), 0, 1) SPC "0");
      if (%r < 1.5)
      {
         mbMineExplode(%mine);
         mbBossHit($Marborg);
         return;
      }
   }
   if ($mbMineRadius > 0 && VectorDist(%mp, %pp) < $mbMineRadius * getWord(%mine.getScale(), 0))
   {
      mbKick(%mp, %pp);
      mbMineExplode(%mine);
   }
}

function mbIsBossDb(%name)
{
   return %name $= "Marborg"
       || %name $= "MarborgLegLeft"
       || %name $= "MarborgLegRight"
       || %name $= "MarborgArmLeft"
       || %name $= "MarborgArmRight"
       || %name $= "MarborgHead";
}

function removeStaticMarborgs(%group)
{
   for (%i = %group.getCount() - 1; %i >= 0; %i--)
   {
      %o = %group.getObject(%i);
      if (!isObject(%o)) continue;
      %cn = %o.getClassName();
      if (%cn $= "SimGroup" || %cn $= "SimSet")
      {
         removeStaticMarborgs(%o);
      }
      else if (%cn $= "StaticShape")
      {
         %db = %o.getDataBlock();
         if (!isObject(%db)) continue;
         if (mbIsBossDb(%db.getName()))
         {
            %o.delete();
         }
      }
   }
}

function mbCollect(%group)
{
   %count = %group.getCount();
   for (%i = 0; %i < %count; %i++)
   {
      %o = %group.getObject(%i);
      if (!isObject(%o)) continue;
      %cn = %o.getClassName();
      if (%cn $= "SimGroup" || %cn $= "SimSet")
         mbCollect(%o);
      else if (%cn $= "StaticShape")
      {
         %db = %o.getDataBlock();
         if (!isObject(%db)) continue;
         %name = %db.getName();
         if (%name $= "LandMineSpecial")
         {
            $mbMine[$mbMineCount] = %o;
            $mbMineCount++;
         }
         else if (%name $= "MarborgSpawner")
            $mbSpawner = %o;
      }
   }
}

function mbReset()
{
   %now = getRealTime();
   if (%now - $mbLastReset < 150) return;
   $mbLastReset = %now;
   for (%i = 0; %i < $mbMineCount; %i++)
   {
      if (isObject($mbMine[%i]))
         mbMineReset($mbMine[%i]);
   }
   mbSpawnBoss();
}

function serverCbOnMissionLoaded()
{
   mbClearBoss();
   $mbMineCount = 0;
   $mbSpawner = "";
   $Marborg = "";
   $mbEndPad = "";
   $mbEndPadSched = "";
   $mbLastReset = 0;
   mbInitText();

   if (isObject(MBMissileGroup)) MBMissileGroup.delete();
   %g = new SimGroup(MBMissileGroup);
   MissionGroup.add(%g);

   mbCollect(MissionGroup);

   if (isObject($mbSpawner))
   {
      $mbSpawner.setScale("0 0 0");
      $mbSpawner.startFade(0, 0, true);
   }

   mbSpawnBoss();
}

function serverCbOnMissionReset() { mbReset(); }
function serverCbOnRespawn() { mbReset(); }

function serverCbOnFrameAdvance(%delta)
{
   %pp = mbPlayerPos();
   if (%pp $= "") return;
   if (%delta > $mbMaxFrame) %delta = $mbMaxFrame;
   if (%delta <= 0) return;

   if (isObject($Marborg))
      mbBossStep($Marborg, %delta, %pp);

   if (isObject(MBMissileGroup))
   {
      for (%i = MBMissileGroup.getCount() - 1; %i >= 0; %i--)
      {
         %m = MBMissileGroup.getObject(%i);
         if (isObject(%m) && %m.getClassName() $= "StaticShape")
            mbMissileStep(%m, %delta, %pp);
      }
   }

   for (%i = 0; %i < $mbMineCount; %i++)
   {
      %mine = $mbMine[%i];
      if (isObject(%mine))
         mbMineStep(%mine, %pp);
   }
}
