{
	friction = 0.01;
	restitution = 1;
	force = 2;
};
new MaterialProperty(HighFrictionMaterial)
{
	friction = 1.5;
	restitution = 0.5;
};
addMaterialMapping("friction_ice", MBFMaterialIce);
addMaterialMapping("ventalation", MBFMaterialMetal);
