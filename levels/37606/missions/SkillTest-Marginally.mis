         artist = "charlemaniac";
         awesomeHint = "If you execute every obstacle in as few tries as with practice you are able, particularly one-shot the start stuff and other easy things, and allow maybe 5 attempts for inconsistent tricks, you should be able to get this.";
         awesomeTime = "120000";
         customRadarRule = "0";
         desc = "Skim for the gems in this challenge.";
         easterEggHint = "Hellscraper.";
         game = "Gold";
         gameMode = "null";
         generalHint = "These tricks are very hard. So if you get stuck don\'t fret. They are all about skimming things.";
         hideRadar = "1";
         level = "1000";
         music = "Classic Vibe.ogg";
         name = "Marginally";
         noBlast = "1";
         persistStartHelpTextTime = "12000";
         platinumTime = "600000";
         startHelpText = "In this level, you will be tested in multiple ways. Let\'s start with a warm-up. Edge hit around the wall and get the gem on the other side of it.";
         trivia = "Level created on February 27, 2026\nUpdates:\nMarch 8, 2026 - Added bounds, replaced trap gravity modifier with slanted platform, and added cheese barriers to ending obstacle.\nSeptember 23, 2026 - Converted help bubbles into help triggers and added camera path, icon picture, challenge times, hints, and trivia.\nTrivia:\nThis sort of area of my first three levels in 2026 (all in February) also marks the beginning of my making higher quality levels in general. Some of these more recent levels turned out very well. In the case of this level, it is a lengthy skill course focused around one topic (I made another one later). Fun fact: some of the obstacles in this level were indirectly inspired when I played the levels from Marble Blast Nostalgia uploaded to Marbleland.";
         type = "Custom";
         ultimateHint = "Practice makes perfect.";
         ultimateTime = "300000";
   };
